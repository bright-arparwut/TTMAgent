# Scanned source PDFs are local-disk only: too large for GitHub's 100 MB
# per-file limit, and the transcription under corpus/<book_id>/ is the
# artifact of record (ticket #28).
corpus/_sources/

# NOTE: corpus/ holds digitized copyrighted book text, committed on the
# owner's decision because this repo is private. Never make this repo
# public or copy corpus/ into a public one.

# Obsidian vault workspace state (per-machine; vault root is corpus/)
.obsidian/
.DS_Store
docs/mockups/ttm-knowledge-graph.html

# Claude Code — keep shared plugin/settings config, ignore local state
.claude/worktrees/
.claude/settings.local.json
.scratch/

# Ticket #24 split: rag_storage/'s graph + KV stores are committed and
# authoritative; the vectors and LLM cache are derived, rebuilt in ~1-3 min
# for $0 by lightrag-rebuild-vdb (see docs/demo-runbook.md).
rag_storage/vdb_*.json
rag_storage/kv_store_llm_response_cache.json

# Editor swap/backup files. Critical: a .env.swp holds the Vim buffer for .env,
# so it carries the secrets .env itself is ignored to protect.
*.swp
*.swo
*~
