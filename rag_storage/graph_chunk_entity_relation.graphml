    <node id="ฝ้าลิ้นสีเหลือง">
      <data key="d0">ฝ้าลิ้นสีเหลือง</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าลิ้นสีเหลืองเป็นลักษณะฝ้าลิ้นในทางการแพทย์แผนจีนที่บ่งชี้อาการโรคจากภายในซึ่งเกิดจากภาวะความร้อน</data>
      <data key="d3">tongue-100-087-chunk-000</data>
