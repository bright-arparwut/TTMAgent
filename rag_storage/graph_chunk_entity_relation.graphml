    <node id="เลือดคั่ง">
      <data key="d0">เลือดคั่ง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์แผนจีน (blood stasis) ที่สื่อถึงโดยจุดเลือดคั่งบนลิ้น สัมพันธ์กับความรุนแรงของโรคไตเรื้อรัง</data>
      <data key="d3">tongue-100-203-chunk-000</data>
