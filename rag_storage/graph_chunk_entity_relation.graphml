      <data key="d6" />
    </node>
    <node id="บวมตามรอยแตกกลาง ตัวลิ้นแดง">
      <data key="d0">บวมตามรอยแตกกลาง ตัวลิ้นแดง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นบวมตามรอยแตกกลางลิ้นโดยตัวลิ้นแดง บ่งชี้ว่าปิตตะสูงร่วมกับความดันหัวใจ&lt;SEP&gt;ลักษณะลิ้นที่บวมตามรอยแตกกลางลิ้นและตัวลิ้นมีสีแดง เป็นลักษณะทางคลินิกที่ใช้เทียบเคียงระหว่างศาสตร์การแพทย์ต่าง ๆ</data>
      <data key="d3">tongue-100-097-chunk-000&lt;SEP&gt;tongue-100-207-chunk-000</data>
      <data key="d4">097-ลิ้นบวม-น.61-62.md&lt;SEP&gt;207-ตารางเทียบเคียง รูปร่าง-น.89-90.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="บวมครึ่งหนึ่ง">
      <data key="d0">บวมครึ่งหนึ่ง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นบวมครึ่งหนึ่ง บ่งชี้ว่าเส้นลมปราณ (Nadi) และช่องร่างกายอ่อนแอ&lt;SEP&gt;ลักษณะลิ้นที่มีอาการบวมเพียงครึ่งหนึ่งของลิ้น เป็นลักษณะทางคลินิกที่ใช้เทียบเคียงระหว่างศาสตร์การแพทย์ต่าง ๆ</data>
      <data key="d3">tongue-100-097-chunk-000&lt;SEP&gt;tongue-100-207-chunk-000</data>
      <data key="d4">097-ลิ้นบวม-น.61-62.md&lt;SEP&gt;207-ตารางเทียบเคียง รูปร่าง-น.89-90.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="บวมด้านข้างบางส่วน">
      <data key="d0">บวมด้านข้างบางส่วน</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นบวมด้านข้างบางส่วน บ่งชี้ว่าวาตะสูงและมีการสะสมในอก&lt;SEP&gt;ลักษณะลิ้นที่มีอาการบวมบางส่วนด้านข้างลิ้น เป็นลักษณะทางคลินิกที่ใช้เทียบเคียงระหว่างศาสตร์การแพทย์ต่าง ๆ</data>
      <data key="d3">tongue-100-097-chunk-000&lt;SEP&gt;tongue-100-207-chunk-000</data>
