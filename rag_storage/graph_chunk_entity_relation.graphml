    <node id="ฝ้าขาว หยาบ และแตก">
      <data key="d0">ฝ้าขาว หยาบ และแตก</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกว่าวาตะมีปัญหาเนื่องจากความร้อนที่มาก</data>
      <data key="d3">tongue-100-102-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md</data>
      <data key="d5">1787913673</data>
