    <node id="แผลวัณโรค">
      <data key="d0">แผลวัณโรค</data>
      <data key="d1">concept</data>
      <data key="d2">โรคลิ้นทางการแพทย์แผนปัจจุบันชนิดหนึ่ง มักเกิดเป็นตุ่มหลายๆ ตุ่มบนผิวด้านบนตามขอบหรือปลายลิ้น เปลี่ยนเป็นแผลเรื้อรัง ขอบไม่เรียบ มีฝ้าสีเทาสกปรก คลำแล้วไม่แข็ง และมีอาการเจ็บปวดมาก</data>
      <data key="d3">tongue-100-039-chunk-000</data>
      <data key="d4">039-แผลวัณโรค-น.40-40.md</data>
      <data key="d5">1787913014</data>
      <data key="d6" />
    </node>
    <node id="แผลริมแข็งของซิฟิลิส">
      <data key="d0">แผลริมแข็งของซิฟิลิส</data>
      <data key="d1">concept</data>
      <data key="d2">แผลชนิดหนึ่งที่เกิดจากโรคซิฟิลิส มีลักษณะแข็งเมื่อคลำดู ใช้เปรียบเทียบความแตกต่างกับแผลวัณโรคที่ไม่แข็ง</data>
      <data key="d3">tongue-100-039-chunk-000</data>
      <data key="d4">039-แผลวัณโรค-น.40-40.md</data>
      <data key="d5">1787913014</data>
      <data key="d6" />
    </node>
    <node id="แผลซิฟิลิส">
      <data key="d0">แผลซิฟิลิส</data>
      <data key="d1">concept</data>
      <data key="d2">แผลที่เกิดจากโรคซิฟิลิส มีลักษณะต่อมน้ำเหลืองใต้คางคลำพบได้ ต่างจากแผลวัณโรค&lt;SEP&gt;โรคหรือแผลที่เกิดจากเชื้อซิฟิลิสในช่องปาก มีหลายระยะและหลายรูปแบบ ได้แก่ แผลริมแข็ง แผลซิฟิลิสระยะที่สอง และแผลซิฟิลิสระยะหลัง</data>
      <data key="d3">tongue-100-039-chunk-000&lt;SEP&gt;tongue-100-038-chunk-000</data>
      <data key="d4">039-แผลวัณโรค-น.40-40.md&lt;SEP&gt;038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913024</data>
      <data key="d6" />
    </node>
    <node id="แผลมะเร็ง">
      <data key="d0">แผลมะเร็ง</data>
      <data key="d1">concept</data>
      <data key="d2">แผลที่เกิดจากโรคมะเร็ง มีลักษณะต่อมน้ำเหลืองใต้คางคลำพบได้ ต่างจากแผลวัณโรค&lt;SEP&gt;โรคของลิ้นทางการแพทย์แผนปัจจุบัน มักเกิดที่ขอบและปลายลิ้น ลักษณะแผลนูนมากและแข็ง ไม่เจ็บปวด ไม่มีฝ้าสกปรกโดยเฉพาะในระยะแรก และสามารถลุกลามทำให้ต่อมน้ำเหลืองโต</data>
      <data key="d3">tongue-100-039-chunk-000&lt;SEP&gt;tongue-100-040-chunk-000</data>
      <data key="d4">039-แผลวัณโรค-น.40-40.md&lt;SEP&gt;040-แผลมะเร็ง-น.41-41.md</data>
      <data key="d5">1787913041</data>
      <data key="d6" />
    </node>
    <node id="ต่อมน้ำเหลืองใต้คาง">
      <data key="d0">ต่อมน้ำเหลืองใต้คาง</data>
      <data key="d1">other</data>
      <data key="d2">ต่อมน้ำเหลืองบริเวณใต้คางซึ่งในกรณีแผลวัณโรคมักคลำไม่ค่อยพบ ต่างจากแผลซิฟิลิสและแผลมะเร็งที่คลำพบได้</data>
      <data key="d3">tongue-100-039-chunk-000</data>
      <data key="d4">039-แผลวัณโรค-น.40-40.md</data>
      <data key="d5">1787913014</data>
      <data key="d6" />
    </node>
    <node id="แผลริมแข็ง">
      <data key="d0">แผลริมแข็ง</data>
      <data key="d1">concept</data>
      <data key="d2">แผลกลมนูนที่ลิ้นในระยะแรกของซิฟิลิส ขนาดเท่าปลายนิ้วชี้หรือปลายนิ้วหัวแม่มือ ขอบนูน คลำแล้วรู้สึกแข็งคล้ายเม็ดกระดุม ไม่ค่อยเจ็บ มักเป็นแผลเดี่ยว</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="ซิฟิลิสระยะแรก">
      <data key="d0">ซิฟิลิสระยะแรก</data>
      <data key="d1">event</data>
      <data key="d2">ระยะแรกของการติดเชื้อซิฟิลิสที่แสดงอาการเป็นแผลริมแข็งที่ลิ้น</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="แผลซิฟิลิสระยะที่สอง">
      <data key="d0">แผลซิฟิลิสระยะที่สอง</data>
      <data key="d1">concept</data>
      <data key="d2">แผลที่เกิดจากซิฟิลิสระยะที่สอง (secondary syphilis, mucous patch) มักเกิดที่ด้านข้างของลิ้น เป็นแผลลึก แข็ง ไม่ค่อยเจ็บ พื้นแผลชื้นและคลุมด้วยฝ้าสีเทาขาววาว มักเกิดหลายแผล มีเชื้อซิฟิลิสอยู่มากและติดต่อง่าย</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="ตุ่มแข็ง">
      <data key="d0">ตุ่มแข็ง</data>
      <data key="d1">concept</data>
      <data key="d2">แผลเรื้อรังชนิดตุ่มแข็ง (gumma) ที่เกิดในระยะหลังของซิฟิลิส มักเป็นที่ผิวบนของลิ้นด้านหลัง ทำให้เกิดรอยบุ๋มและร่องจากแผลเป็น</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="แผลซิฟิลิสระยะหลัง">
      <data key="d0">แผลซิฟิลิสระยะหลัง</data>
      <data key="d1">event</data>
      <data key="d2">ระยะหลังของโรคซิฟิลิสที่แสดงอาการเป็นตุ่มแข็ง (gumma) บนลิ้น ทำให้เกิดรอยบุ๋มและร่องจากแผลเป็น</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="รอยด้านขาว">
      <data key="d0">รอยด้านขาว</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะ leukoplakia ที่เกิดสลับกับส่วนบุ๋มและร่องจากแผลเป็นบนลิ้น เป็นผลจากซิฟิลิสระยะหลัง มีร่องลึกเกิดขึ้นบนรอยนี้ด้วย&lt;SEP&gt;รอยด้านขาว (leucoplakia) เป็นโรคลิ้นทางการแพทย์แผนปัจจุบัน มีลักษณะเป็นปื้นขาวขุ่นจากเยื่อบุผนังปากที่หนาตัวขึ้น ในระยะแรกเรียบ ระยะหลังจะแห้ง แข็ง และแตกเป็นร่อง มักไม่มีอาการเจ็บปวดแต่ทำให้รู้สึกด้าน ๆ ชา ๆ ในปาก และหากเป็นมากอาจกลายเป็นมะเร็งได้</data>
      <data key="d3">tongue-100-038-chunk-000&lt;SEP&gt;tongue-100-042-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md&lt;SEP&gt;042-รอยด้านขาว (leucoplakia)-น.42-42.md</data>
      <data key="d5">1787913083</data>
      <data key="d6" />
    </node>
    <node id="เชื้อซิฟิลิส">
      <data key="d0">เชื้อซิฟิลิส</data>
      <data key="d1">creature</data>
      <data key="d2">เชื้อที่ก่อโรคซิฟิลิส พบมากในแผลซิฟิลิส สามารถติดต่อไปยังผู้ที่สัมผัสแผลได้ง่าย</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="การคลำแผล">
      <data key="d0">การคลำแผล</data>
      <data key="d1">method</data>
      <data key="d2">วิธีตรวจแผลซิฟิลิสด้วยการคลำเพื่อประเมินความแข็งของขอบและพื้นแผล ควรใช้ปลายนิ้วมือที่ไม่มีบาดแผลหรือรอยถลอก และล้างมือทันทีหลังคลำเพื่อป้องกันการติดเชื้อ หรือควรใส่ถุงมือบาง ๆ ขณะคลำ</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="ถุงมือ">
      <data key="d0">ถุงมือ</data>
      <data key="d1">artifact</data>
      <data key="d2">อุปกรณ์ป้องกันที่ควรสวมใส่ขณะคลำแผลซิฟิลิสเพื่อความปลอดภัยจากการติดเชื้อ</data>
      <data key="d3">tongue-100-038-chunk-000</data>
      <data key="d4">038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="ต่อมน้ำเหลือง">
      <data key="d0">ต่อมน้ำเหลือง</data>
      <data key="d1">other</data>
      <data key="d2">ต่อมในร่างกายบริเวณใต้คางหรือคอที่มักโตจนคลำได้เมื่อแผลมะเร็งของลิ้นลุกลาม</data>
      <data key="d3">tongue-100-040-chunk-000</data>
      <data key="d4">040-แผลมะเร็ง-น.41-41.md</data>
      <data key="d5">1787913041</data>
      <data key="d6" />
    </node>
    <node id="มะเร็งช่องปาก">
      <data key="d0">มะเร็งช่องปาก</data>
      <data key="d1">concept</data>
