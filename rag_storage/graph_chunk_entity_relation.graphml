    <node id="เนื้อสัตว์">
      <data key="d0">เนื้อสัตว์</data>
      <data key="d1">data</data>
      <data key="d2">อาหารที่ได้จากสัตว์ ซึ่งเมื่อมนุษย์กินเข้าไปจะรับเอาวิญญาณของสัตว์นั้นเข้ามาด้วย&lt;SEP&gt;อาหารที่เมื่อมนุษย์กินเข้าไปเชื่อว่าจะรับเอาวิญญาณที่สัตว์นั้นเคยเป็นเคยสัมผัสตั้งแต่เกิดจนตาย</data>
      <data key="d3">four-elements-01-chunk-001&lt;SEP&gt;four-elements-01-chunk-002</data>
      <data key="d4">01-บทนำ-น.13-16.md</data>
