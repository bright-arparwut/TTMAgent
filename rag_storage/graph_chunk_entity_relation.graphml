      <data key="d0">เสียชี่อิน</data>
      <data key="d1">concept</data>
      <data key="d2">ปัจจัยก่อโรคจัดอยู่ในหมวดอิน เป็นอันตรายต่อหยางชี่ของร่างกาย&lt;SEP&gt;ปัจจัยก่อโรคภายนอกที่มีลักษณะเป็นอิน มีลักษณะเย็น เมื่อเข้าสู่ร่างกายจะทำให้ความเย็นเพิ่มขึ้นและทำลายหักล้างหยาง เกิดอาการหนาวเย็น</data>
      <data key="d3">tongue-100-015-chunk-000&lt;SEP&gt;tongue-100-016-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md&lt;SEP&gt;016-การแปรเปลี่ยนไปสู่โรคพยาธิ-น.23-23.md</data>
      <data key="d5">1787912725</data>
      <data key="d6" />
    </node>
    <node id="ชีพจร">
      <data key="d0">ชีพจร</data>
      <data key="d1">concept</data>
      <data key="d2">สัญญาณอาการแสดงของโรคในการแพทย์แผนจีน แบ่งลักษณะตามอิน-หยาง เช่น ชีพจรลอยใหญ่ลื่นเร็วแกร่ง (หยาง) และชีพจรจมเล็กฝืดช้าพร่อง (อิน)</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
      <data key="d6" />
    </node>
    <node id="รสยา">
      <data key="d0">รสยา</data>
      <data key="d1">concept</data>
      <data key="d2">การจำแนกรสและฤทธิ์ของยาสมุนไพรจีนตามทฤษฎีอิน-หยาง ประกอบด้วย 4 ฤทธิ์ 5 รส เช่น รสเผ็ดรสหวาน (หยาง) และรสขมรสเปรี้ยวรสเค็ม (อิน)</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
      <data key="d6" />
    </node>
    <node id="แผนภาพอิน-หยาง">
      <data key="d0">แผนภาพอิน-หยาง</data>
      <data key="d1">concept</data>
      <data key="d2">แผนภาพที่ใช้อธิบายลักษณะต่าง ๆ ที่จัดเข้าเป็นหยางและอิน เช่น เพศ เวลา ฤดูกาล ขนาด และอุณหภูมิ</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
      <data key="d6" />
    </node>
    <node id="หน้าที่สรีรวิทยา">
      <data key="d0">หน้าที่สรีรวิทยา</data>
      <data key="d1">concept</data>
      <data key="d2">หมวดการจำแนกอิน-หยางตามหน้าที่การทำงานของร่างกาย เช่น ขึ้นบน-ลงล่าง ออกนอก-เข้าใน กระตุ้น-กดยับยั้ง ให้ความร้อนอุ่น-ให้ความหนาวเย็น</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
      <data key="d6" />
    </node>
    <node id="อาการแสดงของโรค">
      <data key="d0">อาการแสดงของโรค</data>
      <data key="d1">concept</data>
      <data key="d2">หมวดการจำแนกอิน-หยางตามอาการแสดงของโรค เช่น ไข้ร้อน-หนาว จิตตื่นเต้น-จิตหงอยเหงา อุจจาระแห้ง-อุจจาระเหลว ปัสสาวะสั้นเหลืองเข้ม-ปัสสาวะใสขาว สีหน้าสว่างมีเงา-สีหน้ามืดหมองคล้ำ เสียงดังเสียงสูง-เสียงค่อยเสียงต่ำ</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
      <data key="d6" />
    </node>
    <node id="ผู้ชาย">
      <data key="d0">ผู้ชาย</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะที่จัดเข้าเป็นหยางตามแผนภาพอิน-หยาง</data>
      <data key="d3">tongue-100-015-chunk-000</data>
