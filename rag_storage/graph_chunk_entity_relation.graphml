      <data key="d1">concept</data>
      <data key="d2">อาการโรคเย็นชื้นเป็นภาวะความผิดปกติทางการแพทย์แผนจีนที่ทำให้เกิดฝ้าลิ้นสีเทา</data>
      <data key="d3">tongue-100-088-chunk-000</data>
