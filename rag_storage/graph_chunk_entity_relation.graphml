      <data key="d0">Serous Glands (Glands Of Von Ebner)</data>
      <data key="d1">artifact</data>
      <data key="d2">ต่อมน้ำลายขนาดเล็กที่ส่ง serous secretion เข้าไปในร่องที่ล้อมรอบ papilla เพื่อช่วยการรับกลิ่นของ taste buds</data>
      <data key="d3">tongue-100-002-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md</data>
      <data key="d5">1787912290</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นแฉก (ลิ้นขยัก)">
      <data key="d0">ลิ้นแฉก (ลิ้นขยัก)</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะปลายลิ้นที่มนทู่และมีรอยบุ๋มตรงกลางทำให้ปลายลิ้นมีลักษณะเป็นขยัก ถือเป็นเรื่องปกติของแต่ละบุคคล ต่างจากลิ้นแฉกแบบลิ้นงูซึ่งเกิดจากการผ่าตัด</data>
      <data key="d3">tongue-100-002-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md</data>
      <data key="d5">1787912290</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นแฉกแบบลิ้นงู">
      <data key="d0">ลิ้นแฉกแบบลิ้นงู</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะปลายลิ้นที่เป็นแฉก 2-3 แฉกซึ่งเกิดจากการผ่าตัดปลายลิ้น ไม่ใช่ลักษณะตามธรรมชาติ</data>
      <data key="d3">tongue-100-002-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md</data>
      <data key="d5">1787912290</data>
      <data key="d6" />
    </node>
    <node id="Apical Microvilli">
      <data key="d0">Apical Microvilli</data>
      <data key="d1">naturalobject</data>
      <data key="d2">โครงสร้างเล็ก ๆ บนผิวของ taste receptor cells ซึ่งเป็นตำแหน่งที่พบ taste receptor cells (TR1, TR2)</data>
      <data key="d3">tongue-100-002-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md</data>
      <data key="d5">1787912290</data>
      <data key="d6" />
    </node>
    <node id="ปลายลิ้น">
      <data key="d0">ปลายลิ้น</data>
      <data key="d1">location</data>
      <data key="d2">ส่วนปลายของลิ้นซึ่งรูปร่างอาจแหลม มน ทู่ ป้าน หรือเป็นแฉกได้ตามลักษณะเฉพาะของแต่ละบุคคล และเป็นตำแหน่งที่พบลักษณะลิ้นแฉก (ลิ้นขยัก) หรือลิ้นแฉกแบบลิ้นงู&lt;SEP&gt;ส่วนปลายของลิ้นซึ่งเป็นที่ซึ่งน้ำลายมีลักษณะใส&lt;SEP&gt;บริเวณส่วนหนึ่งของลิ้นที่มักพบลักษณะตุ่มรับรสบนผิวลิ้นนูน</data>
      <data key="d3">tongue-100-002-chunk-000&lt;SEP&gt;tongue-100-003-chunk-001&lt;SEP&gt;tongue-100-076-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md&lt;SEP&gt;003-ลิ้นทางการแพทย์แผนไทย-น.6-8.md&lt;SEP&gt;076-ตุ่มรับรสบนผิวลิ้นนูน-น.54-54.md</data>
      <data key="d5">1787913333</data>
      <data key="d6" />
    </node>
    <node id="เหงือกล่าง">
      <data key="d0">เหงือกล่าง</data>
      <data key="d1">location</data>
      <data key="d2">ส่วนของช่องปากที่อยู่สองข้างของลิ้น โดยลิ้นจะนอนนิ่งอยู่ตรงกลางพื้นปากระหว่างเหงือกล่างทั้งสอง</data>
      <data key="d3">tongue-100-002-chunk-000</data>
      <data key="d4">002-การรับรส-น.4-5.md</data>
      <data key="d5">1787912290</data>
