    <node id="ฝ้าลิ้นสีดำ">
      <data key="d0">ฝ้าลิ้นสีดำ</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าลิ้นสีดำ (黑苔) เป็นภาวะทางลิ้นในการแพทย์แผนจีน ซึ่งบ่งชี้ถึงความร้อนสะสมในร่างกายมาก หรือความเย็นสะสมในร่างกายสูงสุด</data>
      <data key="d3">tongue-100-089-chunk-000</data>
      <data key="d4">089-ฝ้าลิ้นสีดำ (黑苔)-น.57-57.md</data>
      <data key="d5">1787913417</data>
      <data key="d6" />
    </node>
    <node id="ความร้อนสะสมในร่างกายมาก">
      <data key="d0">ความร้อนสะสมในร่างกายมาก</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ความร้อนสะสมอยู่ในร่างกายในปริมาณมาก ซึ่งเป็นหนึ่งในสาเหตุที่ทำให้เกิดฝ้าลิ้นสีดำ</data>
      <data key="d3">tongue-100-089-chunk-000</data>
      <data key="d4">089-ฝ้าลิ้นสีดำ (黑苔)-น.57-57.md</data>
      <data key="d5">1787913417</data>
      <data key="d6" />
    </node>
    <node id="ความเย็นสะสมในร่างกายสูงสุด">
      <data key="d0">ความเย็นสะสมในร่างกายสูงสุด</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ความเย็นสะสมอยู่ในร่างกายในระดับสูงสุด ซึ่งเป็นอีกสาเหตุหนึ่งที่ทำให้เกิดฝ้าลิ้นสีดำ</data>
      <data key="d3">tongue-100-089-chunk-000</data>
      <data key="d4">089-ฝ้าลิ้นสีดำ (黑苔)-น.57-57.md</data>
      <data key="d5">1787913417</data>
