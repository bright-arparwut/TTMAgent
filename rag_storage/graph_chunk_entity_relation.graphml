    <node id="ยาแก้พิษร้อน (ประสะจันทน์แดง)">
      <data key="d0">ยาแก้พิษร้อน (ประสะจันทน์แดง)</data>
      <data key="d1">artifact</data>
      <data key="d2">ยาที่ให้แก่ผู้ป่วยหลังตรวจพบชีพจรมีความร้อน แต่อาการยังไม่ดีขึ้น</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
