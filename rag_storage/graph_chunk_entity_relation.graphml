    </node>
    <node id="ชาวอียิปต์">
      <data key="d0">ชาวอียิปต์</data>
      <data key="d1">other</data>
      <data key="d2">กลุ่มคนที่คิดค้นแนวคิดว่าส่วนต่างๆ ของร่างกายคนเราเกี่ยวพันกับสิบสองราศีในทางโหราศาสตร์ หลังจากทฤษฎีธาตุทั้งสี่แพร่หลาย</data>
      <data key="d3">four-elements-05-chunk-000</data>
