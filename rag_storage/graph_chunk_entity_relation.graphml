      <data key="d2">อาการโรคจากภายในเป็นกลุ่มอาการทางการแพทย์แผนจีนที่เกี่ยวข้องกับฝ้าลิ้นสีเหลือง</data>
      <data key="d3">tongue-100-087-chunk-000</data>
