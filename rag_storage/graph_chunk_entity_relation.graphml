    <node id="ความร้อนเพิ่มขึ้นทั้งตัว">
      <data key="d0">ความร้อนเพิ่มขึ้นทั้งตัว</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะความร้อนในร่างกายที่เพิ่มสูงขึ้นทั่วทั้งร่างกาย เป็นภาวะที่สัมพันธ์กับฝ้าสีเทาแบบแห้ง&lt;SEP&gt;ภาวะที่ความร้อนในร่างกายเพิ่มขึ้นทั่วทั้งตัว</data>
      <data key="d3">tongue-100-104-chunk-000&lt;SEP&gt;tongue-100-208-chunk-002</data>
      <data key="d4">104-ฝ้าสีเทา-น.67-67.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="โรคลิ้นทางการแพทย์อายุรเวท">
      <data key="d0">โรคลิ้นทางการแพทย์อายุรเวท</data>
      <data key="d1">concept</data>
      <data key="d2">เนื้อหาหรือหนังสือที่อธิบายเกี่ยวกับการวินิจฉัยโรคผ่านลักษณะลิ้นตามหลักการแพทย์อายุรเวท ครอบคลุมลักษณะฝ้าต่าง ๆ บนลิ้นรวมถึงฝ้าสีเทา&lt;SEP&gt;บทหรือเนื้อหาที่ว่าด้วยการวินิจฉัยโรคผ่านลักษณะของลิ้นตามหลักการแพทย์อายุรเวท ครอบคลุมอาการต่าง ๆ เช่น ลิ้นอ้วนใหญ่&lt;SEP&gt;องค์ความรู้ทางการแพทย์อายุรเวทที่ใช้ลักษณะของลิ้นในการวินิจฉัยโรคต่างๆ ของร่างกาย รวมถึงจุดแดงในส่วนกระเพาะอาหาร&lt;SEP&gt;องค์ความรู้ทางการแพทย์อายุรเวทที่ใช้ลักษณะของลิ้นในการวินิจฉัยโรคและความผิดปกติของอวัยวะภายในร่างกาย&lt;SEP&gt;หมวดหมู่ความรู้เกี่ยวกับการวินิจฉัยโรคผ่านลักษณะของลิ้นตามศาสตร์การแพทย์อายุรเวท ครอบคลุมอาการต่าง ๆ ของลิ้นรวมถึงลิ้นส่วนหัวใจดูไม่มีชีวิตชีวา</data>
      <data key="d3">tongue-100-104-chunk-000&lt;SEP&gt;tongue-100-107-chunk-000&lt;SEP&gt;tongue-100-113-chunk-000&lt;SEP&gt;tongue-100-115-chunk-000&lt;SEP&gt;tongue-100-116-chunk-000</data>
      <data key="d4">104-ฝ้าสีเทา-น.67-67.md&lt;SEP&gt;107-ลิ้นอ้วนใหญ่-น.67-67.md&lt;SEP&gt;113-จุดแดงในส่วนกระเพาะอาหาร-น.71-71.md&lt;SEP&gt;115-จุดสีดำ-เทา ที่บริเวณไตทั้ง 2 ข้าง-น.71-71.md&lt;SEP&gt;116-ลิ้นส่วนหัวใจดูไม่มีชีวิตชีวา-น.72-72.md</data>
      <data key="d5">1787913831</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาว">
      <data key="d0">ฝ้าขาว</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าขาวเป็นภาวะฝ้าที่ลิ้นในทางการแพทย์อายุรเวท มีหลายลักษณะย่อย เช่น บาง หนา แห้ง เปียก แวววาว เลี่ยน ซึ่งสะท้อนภาวะร่างกายเย็นและความชื้นจากภายนอกหรือภายในที่แตกต่างกัน</data>
      <data key="d3">tongue-100-102-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md</data>
      <data key="d5">1787913671</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าบาง">
      <data key="d0">ฝ้าบาง</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าที่หนาพอมองเห็นได้แต่บางพอที่จะมองทะลุไปถึงลิ้น เป็นภาวะร่างกายปกติเมื่อไม่มีอาการอื่น หรืออาจบ่งบอกว่าวาตะถูกรบกวนเล็กน้อย&lt;SEP&gt;ลักษณะฝ้าลิ้นแบบฝ้าบาง ซึ่งตามการแพทย์อายุรเวทถือเป็นภาวะร่างกายปกติเมื่อไม่มีอาการอื่น หรืออาจเป็นภาวะวาตะถูกรบกวนเล็กน้อย และตามการแพทย์แผนจีนบ่งชี้ว่าระดับของโรคอยู่ภายนอกและไม่หนัก</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ไม่มีฝ้า">
      <data key="d0">ไม่มีฝ้า</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่กผะหย่อนหรือไม่สมดุล เกิดจากการขาดสารน้ำหรือร่างกายกำลังลดความร้อน โดยเฉพาะในกระเพาะอาหาร ทำให้ไม่มีสารน้ำอุ่นมาสร้างฝ้าที่ลิ้น&lt;SEP&gt;ลักษณะลิ้นที่ไม่มีฝ้าเลย ตามการแพทย์อายุรเวทบ่งชี้ภาวะกผะหย่อนหรือไม่สมดุล ขาดสารน้ำ หรือร่างกายกำลังลดความร้อน</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าหนา">
      <data key="d0">ฝ้าหนา</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าที่เกิดจากการสะสมของกผะ ความชื้น และความชื้นจากภายนอกที่สร้างเสมหะ บ่งบอกถึงปัญหาของเหลวในระบบเผาผลาญ&lt;SEP&gt;ลักษณะฝ้าลิ้นแบบฝ้าหนา ตามการแพทย์อายุรเวทเกิดจากการสะสมของกผะ ความชื้น และความชื้นจากภายนอกสร้างเสมหะ ตามการแพทย์แผนจีนบ่งชี้ว่าระดับของโรคเข้าสู่ภายในหรือมีความชื้น</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าลิ้นแผนที่">
      <data key="d0">ฝ้าลิ้นแผนที่</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกว่ากระเพาะอาหารถูกรบกวนและของเหลวในทางเดินอาหารและลำไส้หย่อน ทำให้เกิดอาการแสบร้อนกลางอก ท้องผูก และ/หรือความหิวเรื้อรัง&lt;SEP&gt;ลักษณะฝ้าลิ้นแบบแผนที่ ตามการแพทย์อายุรเวทบ่งชี้กระเพาะอาหารถูกรบกวนและของเหลวในทางเดินอาหารและลำไส้หย่อน ตามการแพทย์ตะวันตกสัมพันธ์กับภาวะลิ้นอักเสบ</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา">
      <data key="d0">ฝ้าขาวหนา</data>
      <data key="d1">concept</data>
      <data key="d2">ฝ้าขาวลักษณะหนา เกิดขึ้นเมื่อร่างกายเย็น พลังงานในการย่อยต่ำ หรือทานอาหารที่ย่อยยาก</data>
      <data key="d3">tongue-100-102-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md</data>
      <data key="d5">1787913671</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวบาง แวววาว">
      <data key="d0">ฝ้าขาวบาง แวววาว</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกกผะ-เย็น และความชื้นจากภายนอก&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวบางและแวววาว ตามการแพทย์อายุรเวทบ่งชี้ภาวะกผะ-เย็นและชื้นจากภายนอก ตามการแพทย์แผนจีนบ่งชี้ว่ามีความเย็นและความชื้นจากภายนอกมากระทบ</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา แวววาว">
      <data key="d0">ฝ้าขาวหนา แวววาว</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกโซนปิตตะมีความชื้น มีความเย็น ไฟย่อยต่ำ และมีของเสียสะสม&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวหนาและแวววาว ตามการแพทย์อายุรเวทบ่งชี้โซนปิตตะมีความชื้น ความเย็น ไฟย่อยต่ำ และของเสียสะสม ตามการแพทย์แผนจีนบ่งชี้ความชื้นบริเวณจงเจียวร่วมกับความเย็นและการอุดกั้นของอาหารในกระเพาะอาหาร</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวบาง แห้ง (สีลิ้นปกติ)">
      <data key="d0">ฝ้าขาวบาง แห้ง (สีลิ้นปกติ)</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกว่าสารน้ำในปอดถูกกระทบจากความแห้งภายนอก&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวบางและแห้งโดยสีลิ้นปกติ ตามการแพทย์อายุรเวทบ่งชี้สารน้ำในปอดถูกกระทบจากความแห้งภายนอก ตามการแพทย์แผนจีนบ่งชี้ลมเย็นหรือลมร้อนจากภายนอกกระทบสารน้ำในปอด หรือความแห้งจากภายนอกมากระทบ</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวบาง แห้ง (ตัวลิ้นซีด)">
      <data key="d0">ฝ้าขาวบาง แห้ง (ตัวลิ้นซีด)</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกว่าเลือดถูกรบกวน ปิตตะเฉื่อย และไฟย่อยต่ำ&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวบางและแห้งโดยตัวลิ้นซีด ตามการแพทย์อายุรเวทบ่งชี้เลือดถูกรบกวน ปิตตะเฉื่อย ไฟย่อยต่ำ ตามการแพทย์แผนจีนบ่งชี้ภาวะชี่พร่องและหยางพร่อง</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา เปียก">
      <data key="d0">ฝ้าขาวหนา เปียก</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกไฟย่อยต่ำ มีของเสียมาก จากความเย็นภายนอกกระทบ โซนปิตตะมีความเย็นภายในและชื้น หรือกผะมากและมีความเย็น&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวหนาและเปียก ตามการแพทย์อายุรเวทบ่งชี้ไฟย่อยต่ำ ของเสียมากจากความเย็นภายนอก โซนปิตตะมีความเย็นและชื้น ตามการแพทย์แผนจีนบ่งชี้ลมเย็นจากภายนอกมากระทบร่วมกับความชื้นและความเย็นบริเวณจงเจียว ตามการแพทย์ตะวันตกฝ้ามักมีสีขาวนวลหรือน้ำตาล เมื่อขูดฝ้าออกลิ้นข้างใต้มักอักเสบแดง ให้นึกถึงการติดเชื้อราซึ่งมักเกิดในคนร่างกายอ่อนแอ</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา แห้ง">
      <data key="d0">ฝ้าขาวหนา แห้ง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกร่างกายภายในร้อนและสารน้ำภายในเสีย หรือการสะสมของกผะและความร้อน&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวหนาและแห้ง ตามการแพทย์อายุรเวทบ่งชี้ร่างกายภายในร้อนและสารน้ำภายในเสีย หรือการสะสมของกผะและความร้อน ตามการแพทย์แผนจีนบ่งชี้ของเสียคั่งค้างในร่างกายร่วมกับความร้อน ตามการแพทย์ตะวันตกเมื่อขูดฝ้าออกลิ้นข้างใต้มักอักเสบแดง ให้นึกถึงการติดเชื้อราซึ่งมักเกิดในคนร่างกายอ่อนแอ</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา เลี่ยน">
      <data key="d0">ฝ้าขาวหนา เลี่ยน</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกของเสียมาก ปิตตะน้อย พร้อมกับความชื้นของระบบย่อยอาหาร หรือการสะสมของกผะและของเสีย&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวหนาและเลี่ยน ตามการแพทย์อายุรเวทบ่งชี้ของเสียมาก ปิตตะน้อย ร่วมกับความชื้นของระบบย่อยอาหาร หรือการสะสมของกผะและของเสีย ตามการแพทย์แผนจีนบ่งชี้ภาวะหยางพร่องร่วมกับอาหารอุดกั้นหรือความชื้นสะสม ตามการแพทย์ตะวันตกลิ้นที่เลี่ยนหรือเรียบแสดงว่าตุ่มและต่อมรับรสฝ่อตัว ซึ่งมักพบในโรคขาดอาหาร โรคเลือดจาง โรคกระเพาะลำไส้ที่ทำให้ขาดกรดและน้ำย่อยในกระเพาะอาหาร หรือท้องเดินเรื้อรัง หรือขาดสารอาหาร</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา เลี่ยนและลื่น">
      <data key="d0">ฝ้าขาวหนา เลี่ยนและลื่น</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกของเสียมาก ปิตตะและม้ามน้อย ร่วมกับมีความเย็นและเสมหะชื้น&lt;SEP&gt;ลักษณะฝ้าลิ้นชนิดหนึ่งในการวินิจฉัยแพทย์แผนจีน แสดงถึงของเสียมาก ปิตตะและม้ามอ่อนแอร่วมกับความเย็นและเสมหะชื้น&lt;SEP&gt;ลักษณะฝ้าลิ้นสีขาวหนา เลี่ยนและลื่น ตามการแพทย์อายุรเวทบ่งชี้ของเสียมาก ปิตตะและม้ามน้อยร่วมกับความเย็นและเสมหะชื้น ตามการแพทย์แผนจีนบ่งชี้หยางของม้ามพร่องร่วมกับความชื้นและความเย็น</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000&lt;SEP&gt;tongue-100-208-chunk-001</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ฝ้าขาวหนา เลี่ยนและแห้ง">
      <data key="d0">ฝ้าขาวหนา เลี่ยนและแห้ง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะฝ้าที่บ่งบอกของเสียมากและขาดสารน้ำในร่างกายเนื่องจากมีความร้อนมาก&lt;SEP&gt;ลักษณะฝ้าลิ้นที่แสดงของเสียมากและขาดสารน้ำในร่างกายเนื่องจากมีความร้อนมาก</data>
      <data key="d3">tongue-100-102-chunk-000&lt;SEP&gt;tongue-100-208-chunk-001</data>
      <data key="d4">102-ฝ้าขาว-น.64-65.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
