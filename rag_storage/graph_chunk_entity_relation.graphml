    <node id="ม้ามชื้น">
      <data key="d0">ม้ามชื้น</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะความชื้นในม้ามตามหลักการแพทย์อายุรเวท เป็นภาวะที่สัมพันธ์กับฝ้าสีเทาแบบเปียกและลื่น</data>
      <data key="d3">tongue-100-104-chunk-000</data>
