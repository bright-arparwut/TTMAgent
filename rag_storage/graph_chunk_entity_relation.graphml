      <data key="d3">tongue-100-011-chunk-000</data>
      <data key="d4">011-จุดสะท้อนลิ้นตามศาสตร์การแพทย์อายุรเวท-น.15-16.md</data>
      <data key="d5">1787912560</data>
      <data key="d6" />
    </node>
    <node id="กลางลิ้น">
      <data key="d0">กลางลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">ส่วนของลิ้นที่สัมพันธ์กับธาตุปิตตะและร่างกายตอนกลาง ตามแนวคิดจุดสะท้อนลิ้นม้ามอยู่ซ้ายกลางลิ้นและตับอยู่ทางขวากลางลิ้น</data>
      <data key="d3">tongue-100-011-chunk-000</data>
      <data key="d4">011-จุดสะท้อนลิ้นตามศาสตร์การแพทย์อายุรเวท-น.15-16.md</data>
      <data key="d5">1787912560</data>
      <data key="d6" />
    </node>
    <node id="โคนลิ้น">
      <data key="d0">โคนลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">ส่วนของลิ้นที่สัมพันธ์กับธาตุวาตะและร่างกายส่วนล่าง</data>
      <data key="d3">tongue-100-011-chunk-000</data>
      <data key="d4">011-จุดสะท้อนลิ้นตามศาสตร์การแพทย์อายุรเวท-น.15-16.md</data>
      <data key="d5">1787912560</data>
      <data key="d6" />
