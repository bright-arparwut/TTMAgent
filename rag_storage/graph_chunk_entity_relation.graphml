    <node id="ฝ้าเหลืองบางและแห้ง">
      <data key="d0">ฝ้าเหลืองบางและแห้ง</data>
      <data key="d1">data</data>
      <data key="d2">ลักษณะฝ้าบนลิ้นของผู้ป่วยที่พบจากการตรวจลิ้น บ่งชี้ความร้อนสะสมภายในโดยไม่มีภาวะไข้</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ไข้หลบใน">
      <data key="d0">ไข้หลบใน</data>
      <data key="d1">concept</data>
      <data key="d2">สภาวะไข้เรื้อรังที่ไข้คั่งค้างอยู่ภายใน เกิดการกลับซ้ำได้ง่าย ทำให้เกิดอาการกลุ่มภูมิแพ้ ตกเย็นเพลียคล้ายจะเป็นไข้ พบในผู้ที่เคยเป็นไข้เลือดออก อีสุกอีใส เริม งูสวัด รักษาด้วยยาที่ระบายความร้อนออกเป็นเวลา 1-3 เดือน เป็นการวินิจฉัยของผู้ป่วยรายนี้</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="โรคปลายประสาทอักเสบ">
      <data key="d0">โรคปลายประสาทอักเสบ</data>
      <data key="d1">concept</data>
      <data key="d2">การวินิจฉัยในมุมมองการแพทย์ตะวันตกที่เทียบเคียงกับอาการของผู้ป่วยที่ถูกวินิจฉัยว่าเป็นไข้หลบในทางแพทย์แผนไทย</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="งูสวัด">
      <data key="d0">งูสวัด</data>
      <data key="d1">concept</data>
      <data key="d2">โรคที่ผู้ป่วยไข้หลบในมักเคยเป็นมาก่อน</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ยาไข้หลบใน">
      <data key="d0">ยาไข้หลบใน</data>
      <data key="d1">artifact</data>
      <data key="d2">ยาที่ใช้รักษาไข้หลบใน ไม่ใช่ยาที่เย็นมากแต่เป็นยาที่ระบายความร้อนออก ใช้เวลารักษา 1-3 เดือน</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="Gray-scale">
      <data key="d0">Gray-scale</data>
      <data key="d1">method</data>
      <data key="d2">วิธีปรับภาพลิ้นให้เป็นสีเทาเพื่อช่วยให้เห็นสภาพลิ้นชัดเจนขึ้นสำหรับผู้ที่ดูฝ้าลิ้นไม่ค่อยออก</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ตรวจชีพจร">
      <data key="d0">ตรวจชีพจร</data>
      <data key="d1">method</data>
      <data key="d2">วิธีการตรวจที่แพทย์ใช้กับผู้ป่วย พบว่ามีความร้อน ก่อนนำไปสู่การตรวจลิ้นและวินิจฉัยไข้หลบใน</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ผื่น">
      <data key="d0">ผื่น</data>
      <data key="d1">concept</data>
      <data key="d2">ผื่นบริเวณที่ผู้ป่วยมีอาการปวดแสบปวดร้อน ซึ่งตรวจไม่พบในผู้ป่วยรายนี้</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ความเย็นและความชื้นจากภายนอก">
      <data key="d0">ความเย็นและความชื้นจากภายนอก</data>
      <data key="d1">concept</data>
      <data key="d2">ปัจจัยภายนอกที่เข้ามาในร่างกายผู้ป่วยหลังความร้อนภายในลดลงจนหายไป สัมพันธ์กับลักษณะฝ้าสีขาวบางที่มองเป็นกลุ่มกผะหรือเสมหะ</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ผู้ป่วยที่มีอาการปวดหัว">
      <data key="d0">ผู้ป่วยที่มีอาการปวดหัว</data>
      <data key="d1">person</data>
      <data key="d2">ผู้ป่วยอีกรายหนึ่งที่มีอาการปวดหัว มีภาพลิ้นแสดงประกอบตามแนวทางอายุรเวท</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="ผู้ป่วยที่ปวดกระเพาะอาหาร">
      <data key="d0">ผู้ป่วยที่ปวดกระเพาะอาหาร</data>
      <data key="d1">person</data>
      <data key="d2">ผู้ป่วยอีกรายหนึ่งที่มีอาการปวดกระเพาะอาหาร มีภาพลิ้นแสดงประกอบตามแนวทางอายุรเวท</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
      <data key="d6" />
    </node>
    <node id="โรคไตเรื้อรัง">
      <data key="d0">โรคไตเรื้อรัง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะโรคที่ศึกษาการวินิจฉัยด้วยการตรวจลิ้นตามศาสตร์การแพทย์แผนจีน มีการแบ่งกลุ่มผู้ป่วยตามระดับ eGFR เพื่อเปรียบเทียบลักษณะลิ้น</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="ศาสตร์การแพทย์แผนจีน">
      <data key="d0">ศาสตร์การแพทย์แผนจีน</data>
      <data key="d1">concept</data>
      <data key="d2">องค์ความรู้ทางการแพทย์ที่ใช้การวินิจฉัยลิ้นเพื่อประเมินภาวะสุขภาพและตีความอาการของผู้ป่วยไตเรื้อรัง</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="กลุ่มควบคุม">
      <data key="d0">กลุ่มควบคุม</data>
      <data key="d1">concept</data>
      <data key="d2">กลุ่มผู้เข้าร่วมวิจัยจำนวน 16 คนที่มีค่า eGFR ≥ 60 ใช้เป็นกลุ่มเปรียบเทียบในการศึกษา</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="กลุ่มโรคไตเรื้อรังที่ยังไม่ฟอกไต">
      <data key="d0">กลุ่มโรคไตเรื้อรังที่ยังไม่ฟอกไต</data>
      <data key="d1">concept</data>
      <data key="d2">กลุ่มผู้เข้าร่วมวิจัยจำนวน 38 คน มีค่า 15 ≤ eGFR &lt; 60 นานกว่า 3 เดือน และไม่ได้ฟอกไตเป็นประจำ</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="กลุ่มไตวาย">
      <data key="d0">กลุ่มไตวาย</data>
      <data key="d1">concept</data>
      <data key="d2">กลุ่มผู้เข้าร่วมวิจัยจำนวน 63 คน มีค่า eGFR &lt;15 และต้องฟอกไตเป็นประจำ</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="ระบบวิเคราะห์ลิ้นอัตโนมัติ">
      <data key="d0">ระบบวิเคราะห์ลิ้นอัตโนมัติ</data>
      <data key="d1">artifact</data>
      <data key="d2">เครื่องมือที่ใช้วิเคราะห์รูปร่าง สีลิ้น น้ำลาย ความหนา/สี/ปริมาณของฝ้าลิ้น รอยแตก จุดเลือดคั่ง รอยฟัน และจุดแดง</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นสีซีด">
      <data key="d0">ลิ้นสีซีด</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นที่พบมากในกลุ่มโรคไตเรื้อรังและกลุ่มไตวาย สื่อถึงภาวะเลือดพร่องตามศาสตร์แพทย์แผนจีน</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914038</data>
      <data key="d6" />
    </node>
    <node id="จุดเลือดคั่ง">
      <data key="d0">จุดเลือดคั่ง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะบนลิ้นที่สัมพันธ์กับความรุนแรงของโรคไตเรื้อรัง เมื่อเพิ่มขึ้น 1 หน่วยความเสี่ยงเข้าสู่ระยะฟอกไตเพิ่มขึ้น 1.5 เท่า สื่อถึงภาวะเลือดคั่ง (blood stasis)</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914045</data>
      <data key="d6" />
    </node>
    <node id="รอยฟัน">
      <data key="d0">รอยฟัน</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะบนลิ้นที่พบมากในผู้ป่วยไตเรื้อรัง หมายถึงภาวะพลังชี่พร่อง</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914045</data>
      <data key="d6" />
    </node>
    <node id="การฟอกเลือด">
      <data key="d0">การฟอกเลือด</data>
      <data key="d1">method</data>
      <data key="d2">กระบวนการรักษา (Hemodialysis) ที่ทำให้จำนวนจุดแดงลดลง แต่ร้อยละและพื้นที่ของฝ้าลิ้นเพิ่มขึ้น ส่งผลต่อความชื้นในช่องปากและสมดุลพลังในระบบทางเดินอาหาร</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914045</data>
      <data key="d6" />
    </node>
    <node id="เสมหะชื้น">
      <data key="d0">เสมหะชื้น</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์แผนจีน (phlegm-dampness) ที่สื่อถึงโดยฝ้าลิ้นหนา</data>
      <data key="d3">tongue-100-203-chunk-000</data>
      <data key="d4">203-การใช้ลิ้นวินิจฉัยโรคไตเรื้อรังด้วยศาสตร์การแพทย์แผนจีน-น.84-84.md</data>
      <data key="d5">1787914045</data>
      <data key="d6" />
    </node>
    <node id="พลังชี่พร่อง">
