    <node id="ภาวะเลือดขาดออกซิเจน">
      <data key="d0">ภาวะเลือดขาดออกซิเจน</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะเลือดขาดออกซิเจนเป็นภาวะทางการแพทย์ที่มักแสดงออกมาเมื่อสีของลิ้นม่วง (เขียว) กว่าปกติ&lt;SEP&gt;ภาวะที่เลือดและชี่ไหลเวียนได้ไม่สะดวก ส่งผลให้เลือดขาดออกซิเจน</data>
      <data key="d3">tongue-100-023-chunk-000&lt;SEP&gt;tongue-100-206-chunk-001</data>
      <data key="d4">023-ลิ้นม่วง-น.32-32.md&lt;SEP&gt;206-ตารางเทียบเคียง สี-น.86-88.md</data>
      <data key="d5">1787914185</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นดำ">
      <data key="d0">ลิ้นดำ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ลิ้นมีสีดำหรือมีจุดดำประปราย ซึ่งอาจพบได้ปกติในคนผิวดำหรืออาจเป็นสัญญาณบ่งชี้ความผิดปกติทางการแพทย์</data>
      <data key="d3">tongue-100-024-chunk-000</data>
      <data key="d4">024-ลิ้นดำ-น.32-32.md</data>
      <data key="d5">1787912871</data>
      <data key="d6" />
    </node>
    <node id="โรคต่อมหมวกไตพร่องเรื้อรัง (Addison's Disease)">
      <data key="d0">โรคต่อมหมวกไตพร่องเรื้อรัง (Addison's Disease)</data>
      <data key="d1">concept</data>
      <data key="d2">โรคทางการแพทย์ที่เกิดจากภาวะต่อมหมวกไตทำงานบกพร่องเรื้อรัง ซึ่งอาจแสดงอาการผิดปกติผ่านการเกิดลิ้นดำ</data>
      <data key="d3">tongue-100-024-chunk-000</data>
      <data key="d4">024-ลิ้นดำ-น.32-32.md</data>
      <data key="d5">1787912871</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นผิดปกติ">
      <data key="d0">ลิ้นผิดปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ลิ้นมีลักษณะแตกต่างจากปกติ เช่น ขนาดเล็กหรือใหญ่กว่าปกติ ผิวเหี่ยวย่น หรือหนาผิดปกติ ซึ่งอาจบ่งชี้ถึงโรคหรือภาวะทางการแพทย์ต่าง ๆ</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ภาวะขาดน้ำ">
      <data key="d0">ภาวะขาดน้ำ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ร่างกายขาดน้ำ ซึ่งทำให้ลิ้นมีลักษณะเล็กและแห้ง</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ภาวะขาดอาหาร">
      <data key="d0">ภาวะขาดอาหาร</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ร่างกายขาดสารอาหาร ซึ่งทำให้ลิ้นมีลักษณะเล็กและเลี่ยน</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นใหญ่ทั้งหมด">
      <data key="d0">ลิ้นใหญ่ทั้งหมด</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ลิ้นทั้งลิ้นมีขนาดใหญ่ผิดปกติ (generalized enlargement or hypertrophy) พบในโรคหลายชนิด เช่น กลุ่มโรคดาวน์ ต่อมไทรอยด์พร่อง และโรคอะมีลอยด์</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="กลุ่มโรคดาวน์">
      <data key="d0">กลุ่มโรคดาวน์</data>
      <data key="d1">concept</data>
      <data key="d2">โรคทางพันธุกรรม (Down's syndrome) ที่เป็นหนึ่งในสาเหตุของภาวะลิ้นใหญ่ทั้งหมด</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Cretinism">
      <data key="d0">Cretinism</data>
      <data key="d1">concept</data>
      <data key="d2">สภาพแคระโง่ เป็นภาวะต่อมไทรอยด์พร่องตั้งแต่เกิด (hypothyroidism ในเด็กและทารก) มักพบในพื้นที่ขาดแคลนไอโอดีน ทำให้เกิดปัญญาอ่อนรุนแรง รูปร่างเตี้ย โครงสร้างใบหน้าหยาบ ลิ้นจุกปาก และไส้เลื่อนสะดือ</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Hypothyroidism">
      <data key="d0">Hypothyroidism</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะต่อมไทรอยด์พร่อง ซึ่งมีระยะต่าง ๆ ได้แก่ cretinism ในเด็กและทารก และ myxedema ในเด็กโตและผู้ใหญ่ เป็นสาเหตุหนึ่งของลิ้นใหญ่ทั้งหมด</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Acromegaly">
      <data key="d0">Acromegaly</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะต่อมใต้สมองทำงานมากเกินไปในผู้ใหญ่ เป็นสาเหตุหนึ่งของภาวะลิ้นใหญ่ทั้งหมด&lt;SEP&gt;ภาวะอะโครเมกาลี โรคที่เกิดจากฮอร์โมนการเจริญเติบโตเกิน ซึ่งการแพทย์ตะวันตกระบุว่าพบลักษณะลิ้นอ้วนใหญ่ได้</data>
      <data key="d3">tongue-100-020-chunk-000&lt;SEP&gt;tongue-100-209-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md&lt;SEP&gt;209-ตารางเทียบเคียง ขนาดลิ้น-น.94-94.md</data>
      <data key="d5">1787914259</data>
      <data key="d6" />
    </node>
    <node id="Amyloidosis">
      <data key="d0">Amyloidosis</data>
      <data key="d1">concept</data>
      <data key="d2">โรคอะมีลอยด์ เป็นสาเหตุหนึ่งของภาวะลิ้นใหญ่ทั้งหมด</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Myxedema">
      <data key="d0">Myxedema</data>
      <data key="d1">concept</data>
      <data key="d2">มิกซีดีมา เป็นภาวะ hypothyroidism ที่เกิดในเด็กโตและผู้ใหญ่ ทำให้เกิดอาการอ่อนเพลีย ภาวะไร้อารมณ์ เคลื่อนไหวช้า ขี้หนาว น้ำหนักเพิ่ม และมีการสะสมสารเมทริกซ์ทำให้ใบหน้าใหญ่และลิ้นโต&lt;SEP&gt;ภาวะมิกซีดีมา ที่เกี่ยวข้องกับต่อมไทรอยด์ทำงานต่ำ ซึ่งการแพทย์ตะวันตกระบุว่าพบลักษณะลิ้นอ้วนใหญ่ได้</data>
      <data key="d3">tongue-100-020-chunk-000&lt;SEP&gt;tongue-100-209-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md&lt;SEP&gt;209-ตารางเทียบเคียง ขนาดลิ้น-น.94-94.md</data>
      <data key="d5">1787914259</data>
      <data key="d6" />
    </node>
    <node id="สารเมทริกซ์">
      <data key="d0">สารเมทริกซ์</data>
      <data key="d1">data</data>
      <data key="d2">สารที่สะสมในภาวะ myxedema เช่น ไกลโคซามีโนไกลแคนส์และกรดไฮยาลูโรนิก ทำให้เกิดลักษณะคล้ายอาการบวมน้ำตามผิวหนังและอวัยวะภายใน</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ไกลโคซามีโนไกลแคนส์">
      <data key="d0">ไกลโคซามีโนไกลแคนส์</data>
      <data key="d1">naturalobject</data>
      <data key="d2">สารเมทริกซ์ชนิดหนึ่งที่สะสมในภาวะ myxedema ตามผิวหนังและเนื้อเยื่อ</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="กรดไฮยาลูโรนิก">
      <data key="d0">กรดไฮยาลูโรนิก</data>
      <data key="d1">naturalobject</data>
      <data key="d2">สารเมทริกซ์ชนิดหนึ่งที่สะสมในภาวะ myxedema ตามผิวหนังและเนื้อเยื่อ</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นใหญ่เป็นบางส่วน">
      <data key="d0">ลิ้นใหญ่เป็นบางส่วน</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นใหญ่เฉพาะบางส่วน มักพบในคนที่เป็นเนื้องอกของลิ้นตั้งแต่เกิด&lt;SEP&gt;ภาวะลิ้นใหญ่เฉพาะบางส่วน มักพบในคนที่เป็นเนื้องอกของลิ้นตั้งแต่กำเนิด</data>
      <data key="d3">tongue-100-020-chunk-000&lt;SEP&gt;tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="เนื้องอกของลิ้น">
      <data key="d0">เนื้องอกของลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">เนื้องอกที่เกิดขึ้นกับลิ้นตั้งแต่กำเนิด เป็นสาเหตุของภาวะลิ้นใหญ่เป็นบางส่วน</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นใหญ่กว่าปกติ">
      <data key="d0">ลิ้นใหญ่กว่าปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นที่โตคับปากจริง จนบางครั้งดันปากให้เปิดออกและปลายลิ้นมาจุกอยู่ระหว่างริมฝีปาก การวินิจฉัยไม่ได้ใช้ไม้บรรทัดวัดขนาด แต่ดูจากลักษณะลิ้นที่คับปากจนโผล่ออกมาระหว่างริมฝีปาก</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นหนาผิดปกติ">
      <data key="d0">ลิ้นหนาผิดปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะลิ้นที่โตคับปากบังเหงือกและอาจบังฟันล่างทั้งสองข้าง ด้านบนของลิ้นพองนูนจนดูคับปาก เวลาแลบลิ้นจะเห็นลิ้นยื่นออกมาคับเต็มปากหรือเกือบเต็มปาก</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ไอโอดีน">
      <data key="d0">ไอโอดีน</data>
      <data key="d1">naturalobject</data>
      <data key="d2">ธาตุที่จำเป็นต่อการทำงานของต่อมไทรอยด์ การขาดแคลนไอโอดีนในทารกและเด็กเป็นสาเหตุของภาวะ cretinism มักพบในพื้นที่ที่ขาดแคลนไอโอดีน</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="รูปที่ 1">
      <data key="d0">รูปที่ 1</data>
      <data key="d1">content</data>
      <data key="d2">ภาพประกอบแสดงลิ้นใหญ่กว่าปกติ โตคับปาก ปลายลิ้นมาจุกอยู่ที่ระหว่างริมฝีปาก</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="รูปที่ 2">
      <data key="d0">รูปที่ 2</data>
      <data key="d1">content</data>
      <data key="d2">ภาพประกอบแสดงลิ้นหนาผิดปกติ เวลาแลบลิ้นเห็นลิ้นยื่นออกมาคับเต็มปากหรือเกือบเต็มปาก</data>
      <data key="d3">tongue-100-020-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นบวมน้ำ">
      <data key="d0">ลิ้นบวมน้ำ</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะคล้ายอาการบวมน้ำที่เกิดขึ้นภายในบางอวัยวะ ส่งผลให้ใบหน้าดูใหญ่และหนาขึ้น ลิ้นโต และเสียงทุ้มกว่าปกติ</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ใบหน้าผิดปกติ">
      <data key="d0">ใบหน้าผิดปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะใบหน้าที่ดูใหญ่และหนาขึ้นผิดปกติ ซึ่งเป็นอาการที่พบร่วมกับภาวะลิ้นโตหรือบวมน้ำ</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นโต">
      <data key="d0">ลิ้นโต</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นมีขนาดใหญ่ผิดปกติ (enlargement of the tongue) ซึ่งเป็นหนึ่งในลักษณะที่พบร่วมกับอาการบวมน้ำภายในและใบหน้าผิดปกติ</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="เสียงทุ้มผิดปกติ">
      <data key="d0">เสียงทุ้มผิดปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะเสียงที่ทุ้มกว่าปกติ ซึ่งเป็นอาการที่พบร่วมกับภาวะลิ้นโตและใบหน้าผิดปกติ</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ปานแดง">
      <data key="d0">ปานแดง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะเนื้องอกของลิ้นชนิดหนึ่งที่มีมาตั้งแต่กำเนิด เกี่ยวข้องกับภาวะลิ้นใหญ่เป็นบางส่วน</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Hemangioma">
      <data key="d0">Hemangioma</data>
      <data key="d1">concept</data>
      <data key="d2">เนื้องอกของหลอดเลือด (hemangioma) ที่เป็นสาเหตุหนึ่งของภาวะลิ้นใหญ่เป็นบางส่วนตั้งแต่กำเนิด</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Lymphangioma">
      <data key="d0">Lymphangioma</data>
      <data key="d1">concept</data>
      <data key="d2">เนื้องอกของหลอดน้ำเหลือง (lymphangioma) ที่เป็นสาเหตุหนึ่งของภาวะลิ้นใหญ่เป็นบางส่วนตั้งแต่กำเนิด</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นบวม">
      <data key="d0">ลิ้นบวม</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นบวม (swelling) ที่ทำให้ลิ้นดูใหญ่กว่าปกติคล้ายลิ้นใหญ่ แต่ผู้ป่วยมักมีอาการเจ็บปวดและขยับหรือเคลื่อนไหวลิ้นไม่สะดวก&lt;SEP&gt;ภาวะผิดปกติของลิ้นที่มีลักษณะบวม ซึ่งอาจเกิดร่วมกับลิ้นอักเสบ&lt;SEP&gt;ภาวะลิ้นบวมตามการแพทย์อายุรเวท ซึ่งแบ่งลักษณะตามตำแหน่งและสีของลิ้นเพื่อบ่งชี้ความผิดปกติของธาตุและอวัยวะภายใน&lt;SEP&gt;ลักษณะลิ้นที่บวม บ่งบอกถึงภาวะร้อนและเย็นชื้น รวมถึงเสมหะล้นตามการแพทย์เกาหลี</data>
      <data key="d3">tongue-100-020-chunk-001&lt;SEP&gt;tongue-100-035-chunk-000&lt;SEP&gt;tongue-100-097-chunk-000&lt;SEP&gt;tongue-100-125-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md&lt;SEP&gt;035-ลิ้นอักเสบ (glossitis)-น.38-38.md&lt;SEP&gt;097-ลิ้นบวม-น.61-62.md&lt;SEP&gt;125-ลักษณะลิ้น - การแพทย์เกาหลี-น.76-76.md</data>
      <data key="d5">1787913938</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นที่บวมใหญ่ขึ้นทันที">
      <data key="d0">ลิ้นที่บวมใหญ่ขึ้นทันที</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นบวมใหญ่ขึ้นอย่างฉับพลัน มักเกิดจากการแพ้ยา อาหาร หรือสิ่งอื่น (angioneurotic edema) อาจมีอาการหน้าบวม หายใจหอบเหนื่อย ผื่นคันร่วมด้วย</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Angioneurotic Edema">
      <data key="d0">Angioneurotic Edema</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะบวมจากการแพ้ยา อาหาร หรือสิ่งอื่น ทำให้เกิดลิ้นที่บวมใหญ่ขึ้นทันที อาจมีหน้าบวม หายใจหอบเหนื่อย ผื่นคันร่วมด้วย</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="การแพ้ยาหรืออาหาร">
      <data key="d0">การแพ้ยาหรืออาหาร</data>
      <data key="d1">concept</data>
      <data key="d2">สาเหตุของภาวะลิ้นที่บวมใหญ่ขึ้นทันที ทำให้เกิดอาการแพ้ต่อร่างกาย</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นที่บวมใหญ่">
      <data key="d0">ลิ้นที่บวมใหญ่</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นบวมใหญ่ที่อาจเกิดจากลิ้นอักเสบ ปากอักเสบ การอุดตันของหลอดเลือดดำหรือหลอดน้ำเหลืองที่รับเลือดหรือน้ำเหลืองจากหน้าและลิ้น</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Glossitis">
      <data key="d0">Glossitis</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นอักเสบ (glossitis) ซึ่งเป็นสาเหตุหนึ่งของลิ้นที่บวมใหญ่&lt;SEP&gt;ชื่อภาษาอังกฤษของภาวะลิ้นอักเสบ ซึ่งเป็นสาเหตุที่พบบ่อยของลิ้นขรุขระมาก&lt;SEP&gt;ภาวะลิ้นอักเสบตามการแพทย์ตะวันตก ซึ่งอาจเกิดจากหลายสาเหตุ รวมถึงโรคอื่นที่ไม่ได้เฉพาะที่ลิ้น</data>
      <data key="d3">tongue-100-020-chunk-001&lt;SEP&gt;tongue-100-031-chunk-000&lt;SEP&gt;tongue-100-210-chunk-000</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md&lt;SEP&gt;031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md&lt;SEP&gt;210-ตารางเทียบเคียง ตรวจลักษณะของลิ้น-น.95-96.md</data>
      <data key="d5">1787914311</data>
      <data key="d6" />
    </node>
    <node id="Stomatitis">
      <data key="d0">Stomatitis</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะปากอักเสบ (stomatitis) ซึ่งเป็นสาเหตุหนึ่งของลิ้นที่บวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="การอุดตันของหลอดเลือดดำหรือหลอดน้ำเหลือง">
      <data key="d0">การอุดตันของหลอดเลือดดำหรือหลอดน้ำเหลือง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะการอุดตันของหลอดเลือดดำหรือหลอดน้ำเหลืองที่รับเลือดหรือน้ำเหลืองจากหน้าและลิ้น เป็นสาเหตุหนึ่งของลิ้นที่บวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="มะเร็งปอด">
      <data key="d0">มะเร็งปอด</data>
      <data key="d1">concept</data>
      <data key="d2">โรคมะเร็งปอดที่อาจลุกลามไปกดหลอดเลือดดำใหญ่ในอกบน ทำให้เกิด superior vena cava syndrome และลิ้นบวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="Superior Vena Cava Syndrome">
      <data key="d0">Superior Vena Cava Syndrome</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่หลอดเลือดดำใหญ่ในอกบนถูกกดทับ (superior vena cava syndrome) มักเกิดจากมะเร็งปอดที่ลุกลาม ส่งผลให้ลิ้นบวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ต่อมน้ำเหลืองบริเวณคออักเสบ">
      <data key="d0">ต่อมน้ำเหลืองบริเวณคออักเสบ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะต่อมน้ำเหลืองบริเวณคอเกิดอักเสบมาก ซึ่งเป็นสาเหตุหนึ่งของลิ้นที่บวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="มะเร็งที่ปิดกั้นการไหลเวียนของน้ำเหลือง">
      <data key="d0">มะเร็งที่ปิดกั้นการไหลเวียนของน้ำเหลือง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะมะเร็งที่ลุกลามจนปิดกั้นการไหลเวียนของน้ำเหลือง ซึ่งเป็นสาเหตุหนึ่งของลิ้นที่บวมใหญ่</data>
      <data key="d3">tongue-100-020-chunk-001</data>
      <data key="d4">020-ลิ้นผิดปกติ-น.27-30.md</data>
      <data key="d5">1787912877</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นแดงสด">
      <data key="d0">ลิ้นแดงสด</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะอาการทางการแพทย์แผนปัจจุบันที่ลิ้นมีสีแดงชัดหรือแดงสดจนน่ากลัว เป็นสัญญาณบ่งชี้ที่อาจสัมพันธ์กับภาวะลิ้นอักเสบ</data>
      <data key="d3">tongue-100-025-chunk-000</data>
      <data key="d4">025-ลิ้นแดงสด-น.33-33.md</data>
      <data key="d5">1787912885</data>
      <data key="d6" />
    </node>
    <node id="ภาวะลิ้นอักเสบ">
      <data key="d0">ภาวะลิ้นอักเสบ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์ (glossitis) ที่ทำให้ลิ้นมีสีแดงสด อาจเกิดจากโรคของร่างกายทั่วไป เช่น การขาดสารอาหาร โรคไข้รากสาดน้อย และโรคไข้อีดำอีแดง&lt;SEP&gt;ภาวะทางการแพทย์ตะวันตกที่สัมพันธ์กับลักษณะฝ้าลิ้นแผนที่</data>
      <data key="d3">tongue-100-025-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">025-ลิ้นแดงสด-น.33-33.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="การขาดสารอาหาร">
      <data key="d0">การขาดสารอาหาร</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะขาดสารอาหารในร่างกาย ซึ่งเป็นหนึ่งในสาเหตุที่อาจทำให้เกิดภาวะลิ้นอักเสบ&lt;SEP&gt;ภาวะที่ร่างกายได้รับสารอาหารไม่เพียงพอ เป็นสาเหตุหนึ่งที่ทำให้ตุ่มและต่อมลิ้มรสฝ่อตัวจนลิ้นเลี่ยนหรือเรียบ&lt;SEP&gt;สาเหตุหนึ่งของการอักเสบที่ลิ้น เกิดจากภาวะขาดสารอาหารในร่างกาย</data>
      <data key="d3">tongue-100-025-chunk-000&lt;SEP&gt;tongue-100-030-chunk-000&lt;SEP&gt;tongue-100-035-chunk-000</data>
      <data key="d4">025-ลิ้นแดงสด-น.33-33.md&lt;SEP&gt;030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md&lt;SEP&gt;035-ลิ้นอักเสบ (glossitis)-น.38-38.md</data>
      <data key="d5">1787912984</data>
      <data key="d6" />
    </node>
    <node id="โรคไข้รากสาดน้อย">
      <data key="d0">โรคไข้รากสาดน้อย</data>
      <data key="d1">concept</data>
      <data key="d2">โรคติดเชื้อที่เรียกอีกชื่อว่าไทฟอยด์ เป็นหนึ่งในสาเหตุที่อาจทำให้เกิดภาวะลิ้นอักเสบ&lt;SEP&gt;โรคไข้รากสาดน้อย (typhoid fever) เป็นโรคที่อาจเกิดขึ้นที่อื่นในร่างกาย (ไม่ได้เฉพาะที่ลิ้น) และเป็นสาเหตุหนึ่งที่ทำให้เกิดลิ้นขรุขระมาก&lt;SEP&gt;โรค typhoid fever ที่อาจเป็นสาเหตุหนึ่งของภาวะลิ้นอักเสบ (glossitis) ตามการแพทย์ตะวันตก</data>
      <data key="d3">tongue-100-025-chunk-000&lt;SEP&gt;tongue-100-031-chunk-000&lt;SEP&gt;tongue-100-210-chunk-000</data>
      <data key="d4">025-ลิ้นแดงสด-น.33-33.md&lt;SEP&gt;031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md&lt;SEP&gt;210-ตารางเทียบเคียง ตรวจลักษณะของลิ้น-น.95-96.md</data>
      <data key="d5">1787914311</data>
      <data key="d6" />
    </node>
    <node id="โรคไข้อีดำอีแดง">
      <data key="d0">โรคไข้อีดำอีแดง</data>
      <data key="d1">concept</data>
      <data key="d2">โรคที่มีชื่อภาษาอังกฤษว่า scarlet fever เป็นหนึ่งในสาเหตุที่อาจทำให้เกิดภาวะลิ้นอักเสบ&lt;SEP&gt;โรคไข้อีดำอีแดง (scarlet fever) เป็นโรคที่อาจเกิดขึ้นที่อื่นในร่างกาย (ไม่ได้เฉพาะที่ลิ้น) และเป็นสาเหตุหนึ่งที่ทำให้เกิดลิ้นขรุขระมาก&lt;SEP&gt;โรค scarlet fever ที่อาจเป็นสาเหตุหนึ่งของภาวะลิ้นอักเสบ (glossitis) ตามการแพทย์ตะวันตก</data>
      <data key="d3">tongue-100-025-chunk-000&lt;SEP&gt;tongue-100-031-chunk-000&lt;SEP&gt;tongue-100-210-chunk-000</data>
      <data key="d4">025-ลิ้นแดงสด-น.33-33.md&lt;SEP&gt;031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md&lt;SEP&gt;210-ตารางเทียบเคียง ตรวจลักษณะของลิ้น-น.95-96.md</data>
      <data key="d5">1787914311</data>
      <data key="d6" />
    </node>
    <node id="ปากแห้ง">
      <data key="d0">ปากแห้ง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ปากมีความชื้นน้อย เป็นสาเหตุหลักของการเกิดฝ้าลิ้น เกิดได้จากหลายปัจจัย เช่น น้ำลายน้อย หายใจทางปาก ดื่มน้ำน้อย สูบบุหรี่จัด บ้วนปากน้อย นอนดึก&lt;SEP&gt;สภาพความแห้งของปากที่พบร่วมกับลิ้นแห้งในคนที่หายใจทางปากหรือสูบบุหรี่จัด โดยลิ้นจะไม่เหี่ยวย่น</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-027-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;027-ลิ้นแห้ง-น.34-34.md</data>
      <data key="d5">1787912919</data>
      <data key="d6" />
    </node>
    <node id="การย่อยอาหารผิดปกติ">
      <data key="d0">การย่อยอาหารผิดปกติ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะผิดปกติของระบบย่อยอาหาร ซึ่งเป็นหนึ่งในสาเหตุส่วนน้อยที่ทำให้เกิดฝ้าลิ้น</data>
      <data key="d3">tongue-100-026-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md</data>
      <data key="d5">1787912904</data>
      <data key="d6" />
    </node>
    <node id="ท้องผูก">
      <data key="d0">ท้องผูก</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะการขับถ่ายผิดปกติ ซึ่งเป็นหนึ่งในสาเหตุส่วนน้อยที่ทำให้เกิดฝ้าลิ้น&lt;SEP&gt;อาการแสดงอย่างหนึ่งที่พบร่วมกับภาวะลิ้นสีแดง</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-069-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;069-ลิ้นสีแดง (舌红)-น.50-51.md</data>
      <data key="d5">1787913287</data>
      <data key="d6" />
    </node>
    <node id="ไข้">
      <data key="d0">ไข้</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะมีไข้จากสาเหตุต่าง ๆ ซึ่งเป็นหนึ่งในสาเหตุส่วนน้อยที่ทำให้เกิดฝ้าลิ้น และยังเป็นภาวะที่พบร่วมกับการติดเชื้อราในลิ้น&lt;SEP&gt;อาการตัวร้อนที่เป็นนาน ๆ ซึ่งเป็นสาเหตุหนึ่งที่ทำให้เกิดลิ้นแห้ง&lt;SEP&gt;ภาวะร่างกายมีอุณหภูมิสูงกว่าปกติ เป็นหนึ่งในปัจจัยที่ทำให้เกิดแผลร้อนใน&lt;SEP&gt;ความเจ็บป่วยที่ทำให้เกิดอาการไข้ ซึ่งอาจเป็นสาเหตุของความร้อนภายในที่สะท้อนออกมาทางลิ้นแดง&lt;SEP&gt;ภาวะไข้ที่ทำให้เกิดความร้อนภายในร่างกาย แสดงออกผ่านลักษณะฝ้าเหลืองบนลิ้น&lt;SEP&gt;ภาวะทางการแพทย์ที่ทำให้ร่างกายอ่อนแอและเสี่ยงต่อการติดเชื้อราที่ลิ้น</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-027-chunk-000&lt;SEP&gt;tongue-100-037-chunk-000&lt;SEP&gt;tongue-100-094-chunk-000&lt;SEP&gt;tongue-100-103-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;027-ลิ้นแห้ง-น.34-34.md&lt;SEP&gt;037-ร้อนใน-น.39-39.md&lt;SEP&gt;094-ลิ้นแดง-น.59-60.md&lt;SEP&gt;103-ฝ้าเหลือง-น.66-66.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="การติดเชื้อรา">
      <data key="d0">การติดเชื้อรา</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะการติดเชื้อราในช่องปาก ทำให้เกิดฝ้าลิ้นสีขาวนวลหรือน้ำตาลหนา เมื่อขูดฝ้าออกลิ้นข้างใต้จะอักเสบแดง มักเกิดในคนที่ร่างกายอ่อนแอ เช่น เป็นไข้ เป็นเบาหวาน เป็นเอดส์&lt;SEP&gt;ภาวะการติดเชื้อที่ลิ้น ซึ่งเมื่อขูดฝ้าออกลิ้นข้างใต้มักอักเสบแดง มักเกิดในคนที่ร่างกายอ่อนแอ เช่น ผู้ที่เป็นไข้ เบาหวาน หรือเอดส์</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="เบาหวาน">
      <data key="d0">เบาหวาน</data>
      <data key="d1">concept</data>
      <data key="d2">โรคเบาหวาน เป็นภาวะที่ทำให้ร่างกายอ่อนแอและเสี่ยงต่อการติดเชื้อราในลิ้น&lt;SEP&gt;โรคเรื้อรังที่ทำให้ร่างกายอ่อนแอและเสี่ยงต่อการติดเชื้อราที่ลิ้น</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="เอดส์">
      <data key="d0">เอดส์</data>
      <data key="d1">concept</data>
      <data key="d2">โรคเอดส์ เป็นภาวะที่ทำให้ร่างกายอ่อนแอและเสี่ยงต่อการติดเชื้อราในลิ้น&lt;SEP&gt;โรคที่ทำให้ระบบภูมิคุ้มกันอ่อนแอและเสี่ยงต่อการติดเชื้อราที่ลิ้น</data>
      <data key="d3">tongue-100-026-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="ยาทาปากสีม่วง (Gentian Violet)">
      <data key="d0">ยาทาปากสีม่วง (Gentian Violet)</data>
      <data key="d1">artifact</data>
      <data key="d2">ยาทาสีม่วงที่ใช้ทาบริเวณที่เป็นฝ้าลิ้นจากการติดเชื้อรา ช่วยให้การติดเชื้อราทุเลาลงได้</data>
      <data key="d3">tongue-100-026-chunk-000</data>
      <data key="d4">026-ฝ้าลิ้น (coated tongue)-น.33-33.md</data>
      <data key="d5">1787912904</data>
