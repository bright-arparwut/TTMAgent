    </node>
    <node id="ต่อมลิ้มรส">
      <data key="d0">ต่อมลิ้มรส</data>
      <data key="d1">artifact</data>
      <data key="d2">อวัยวะรับรสบนลิ้นที่มีจำนวนมากในภาวะปกติ หากฝ่อตัวจะทำให้ลิ้นมีผิวเลี่ยนหรือเรียบ</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912948</data>
      <data key="d6" />
    </node>
    <node id="โรคขาดอาหาร">
      <data key="d0">โรคขาดอาหาร</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์ที่ทำให้ร่างกายขาดสารอาหาร ซึ่งเป็นสาเหตุหนึ่งที่ทำให้ตุ่มและต่อมลิ้มรสฝ่อตัวจนลิ้นเลี่ยนหรือเรียบ&lt;SEP&gt;โรคที่เกี่ยวข้องกับภาวะขาดสารอาหาร ซึ่งอาจสัมพันธ์กับอาการลิ้นเลี่ยนหรือเรียบและตุ่มรับรสฝ่อตัว&lt;SEP&gt;โรคที่ทำให้ตุ่มและต่อมรับรสบนลิ้นฝ่อตัว ส่งผลให้ลิ้นมีลักษณะเลี่ยนหรือเรียบ</data>
      <data key="d3">tongue-100-030-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000&lt;SEP&gt;tongue-100-208-chunk-001</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="โรคเลือดจาง">
      <data key="d0">โรคเลือดจาง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์ที่เกี่ยวข้องกับเลือด ซึ่งมักพบร่วมกับอาการลิ้นเลี่ยนหรือเรียบเนื่องจากตุ่มและต่อมลิ้มรสฝ่อตัว&lt;SEP&gt;โรคที่เกี่ยวข้องกับภาวะเลือดจาง ซึ่งอาจสัมพันธ์กับอาการลิ้นเลี่ยนหรือเรียบและตุ่มรับรสฝ่อตัว&lt;SEP&gt;โรคที่ทำให้ตุ่มและต่อมรับรสบนลิ้นฝ่อตัว ส่งผลให้ลิ้นมีลักษณะเลี่ยนหรือเรียบ</data>
      <data key="d3">tongue-100-030-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000&lt;SEP&gt;tongue-100-208-chunk-001</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="โรคกระเพาะลำไส้">
      <data key="d0">โรคกระเพาะลำไส้</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์ที่ทำให้เกิดการขาดกรดและน้ำย่อยในกระเพาะอาหาร หรือท้องเดินเรื้อรัง ซึ่งเป็นสาเหตุหนึ่งของลิ้นเลี่ยนหรือเรียบ&lt;SEP&gt;โรคที่ทำให้เกิดการขาดกรดและน้ำย่อยในกระเพาะอาหาร หรือเกิดอาการท้องเดินเรื้อรัง หรือเกิดการขาดสารอาหาร&lt;SEP&gt;โรคที่ทำให้ขาดกรดและน้ำย่อยในกระเพาะอาหาร หรือเกิดอาการท้องเดินเรื้อรัง ส่งผลให้ตุ่มและต่อมรับรสบนลิ้นฝ่อตัว</data>
      <data key="d3">tongue-100-030-chunk-000&lt;SEP&gt;tongue-100-208-chunk-000&lt;SEP&gt;tongue-100-208-chunk-001</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md&lt;SEP&gt;208-ตารางเทียบเคียง ฝ้า-น.90-94.md</data>
      <data key="d5">1787914205</data>
      <data key="d6" />
    </node>
    <node id="การขาดกรดและน้ำย่อยในกระเพาะอาหาร">
      <data key="d0">การขาดกรดและน้ำย่อยในกระเพาะอาหาร</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่เกิดจากโรคกระเพาะลำไส้ ซึ่งเป็นหนึ่งในสาเหตุที่ทำให้ตุ่มและต่อมลิ้มรสฝ่อตัวจนลิ้นเลี่ยน</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912948</data>
      <data key="d6" />
    </node>
    <node id="อาการท้องเดินเรื้อรัง">
      <data key="d0">อาการท้องเดินเรื้อรัง</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะท้องเดินที่เกิดขึ้นต่อเนื่องเป็นเวลานาน ซึ่งเป็นสาเหตุหนึ่งของอาการลิ้นเลี่ยนหรือเรียบ</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912949</data>
      <data key="d6" />
    </node>
    <node id="ภาวะขาดวิตามินเอ">
      <data key="d0">ภาวะขาดวิตามินเอ</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์ที่เกี่ยวข้องกับการขาดวิตามินเอ มักพบร่วมกับอาการลิ้นเลี่ยนหรือเรียบที่เกิดเป็นหย่อม ๆ กระจัดกระจาย</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912949</data>
      <data key="d6" />
    </node>
    <node id="อาการอักเสบของลิ้น">
      <data key="d0">อาการอักเสบของลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">อาการที่ลิ้นมีลักษณะแดงและเจ็บ ซึ่งมักพบร่วมกับอาการลิ้นเลี่ยนหรือเรียบ</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912949</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นเป็นร่อง">
      <data key="d0">ลิ้นเป็นร่อง</data>
      <data key="d1">concept</data>
      <data key="d2">ลิ้นเป็นร่อง (furrowed or fissured tongue) คือภาวะที่ลิ้นมีลักษณะเป็นร่องลึกกว่าปกติ มักพบเป็นลักษณะปกติของคนบางคนมาแต่กำเนิด และอาจเป็นกรรมพันธุ์</data>
      <data key="d3">tongue-100-032-chunk-000</data>
      <data key="d4">032-ลิ้นเป็นร่อง (furrowed or fissured tongue)-น.36-36.md</data>
      <data key="d5">1787912954</data>
      <data key="d6" />
    </node>
    <node id="กรรมพันธุ์">
      <data key="d0">กรรมพันธุ์</data>
      <data key="d3">tongue-100-032-chunk-000</data>
      <data key="d2">ลิ้นเป็นร่องอาจเกิดจากกรรมพันธุ์ ซึ่งพบลักษณะนี้ในญาติพี่น้องด้วยได้</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">032-ลิ้นเป็นร่อง (furrowed or fissured tongue)-น.36-36.md</data>
      <data key="d5">1787912955</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นแผนที่">
      <data key="d0">ลิ้นแผนที่</data>
      <data key="d1">concept</data>
      <data key="d2">ลิ้นแผนที่ (geographic tongue) คือภาวะของลิ้นที่มีเส้นหรือส่วนนูนเป็นขอบ หรือเป็นปื้นที่มีขอบเขตยึกยือไม่เรียบคล้ายขอบเขตพื้นดินและพื้นน้ำบนแผนที่ ส่วนมากเกิดจากภาวะลิ้นอักเสบ</data>
      <data key="d3">tongue-100-033-chunk-000</data>
      <data key="d4">033-ลิ้นแผนที่ (geographic tongue)-น.37-37.md</data>
      <data key="d5">1787912963</data>
      <data key="d6" />
    </node>
    <node id="ขอบลิ้นหยัก">
      <data key="d0">ขอบลิ้นหยัก</data>
      <data key="d1">concept</data>
      <data key="d2">ขอบลิ้นหยัก (Indented edge) หมายถึงขอบลิ้นซึ่งมีรอยบุ๋มเข้าไป มักเกิดตรงบริเวณลิ้นที่อยู่ชิดกับฟันที่เกหรือเขยื่นออกนอกแถว เกิดจากการถูกฟันขบกันบ่อย ๆ จนเป็นแผลและแผลเป็น เป็นอาการที่จัดอยู่ในหมวดโรคลิ้นทางการแพทย์แผนปัจจุบัน</data>
      <data key="d3">tongue-100-034-chunk-000</data>
      <data key="d4">034-ขอบลิ้นหยัก (Indented edge)-น.37-37.md</data>
      <data key="d5">1787912976</data>
      <data key="d6" />
    </node>
    <node id="ฟันเก">
      <data key="d0">ฟันเก</data>
      <data key="d1">concept</data>
      <data key="d2">ฟันที่ขึ้นเกหรือยื่นออกนอกแถวฟัน เป็นสาเหตุที่ทำให้เกิดการขบกับขอบลิ้นบ่อย ๆ จนเกิดแผลและแผลเป็นเป็นรอยบุ๋มที่ขอบลิ้น</data>
      <data key="d3">tongue-100-034-chunk-000</data>
      <data key="d4">034-ขอบลิ้นหยัก (Indented edge)-น.37-37.md</data>
      <data key="d5">1787912976</data>
      <data key="d6" />
    </node>
    <node id="แผลเป็น">
      <data key="d0">แผลเป็น</data>
      <data key="d1">concept</data>
      <data key="d2">รอยแผลที่เกิดขึ้นหลังจากการเป็นแผล ซึ่งเมื่อเกิดที่ขอบลิ้นจะทำให้เกิดรอยบุ๋มเป็นขอบลิ้นหยัก</data>
      <data key="d3">tongue-100-034-chunk-000</data>
      <data key="d4">034-ขอบลิ้นหยัก (Indented edge)-น.37-37.md</data>
      <data key="d5">1787912976</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นใหญ่">
      <data key="d0">ลิ้นใหญ่</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะลิ้นมีขนาดใหญ่ ซึ่งเป็นสาเหตุอื่นที่ทำให้เกิดแผลและแผลเป็นจนทำให้ขอบลิ้นหยักได้เช่นเดียวกับสาเหตุจากฟันเก&lt;SEP&gt;ลักษณะลิ้นที่ค่อนข้างใหญ่กว่าปกติในการวินิจฉัยลิ้นทางการแพทย์แผนจีน&lt;SEP&gt;ภาวะลิ้นมีขนาดใหญ่ตามการแพทย์ตะวันตก ซึ่งเป็นสาเหตุหนึ่งที่ทำให้ขอบลิ้นเกิดรอยหยัก</data>
      <data key="d3">tongue-100-034-chunk-000&lt;SEP&gt;tongue-100-074-chunk-000&lt;SEP&gt;tongue-100-210-chunk-000</data>
      <data key="d4">034-ขอบลิ้นหยัก (Indented edge)-น.37-37.md&lt;SEP&gt;074-ลักษณะลิ้นอ้วนใหญ่ (舌胖大)-น.53-53.md&lt;SEP&gt;210-ตารางเทียบเคียง ตรวจลักษณะของลิ้น-น.95-96.md</data>
      <data key="d5">1787914311</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นเล็ก">
      <data key="d0">ลิ้นเล็ก</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะผิดปกติของลิ้นที่มีขนาดเล็ก ซึ่งอาจเกิดร่วมกับลิ้นอักเสบ</data>
      <data key="d3">tongue-100-035-chunk-000</data>
      <data key="d4">035-ลิ้นอักเสบ (glossitis)-น.38-38.md</data>
