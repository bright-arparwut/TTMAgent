    <node id="ลิ้นมีปื้นเลือดหรือมีจุดจ้ำเลือด">
      <data key="d0">ลิ้นมีปื้นเลือดหรือมีจุดจ้ำเลือด</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะความผิดปกติของลิ้นทางการแพทย์แผนจีน หมายถึงตัวลิ้นมีจุดเลือดหรือปื้นเลือดขนาดใหญ่หรือเล็ก จุดหรือปื้นเลือดที่อุดตันมีสีม่วงหรือสีม่วงดำอยู่ในตัวเนื้อลิ้น ไม่โผล่มาที่ตัวผิวลิ้น</data>
      <data key="d3">tongue-100-080-chunk-000</data>
      <data key="d4">080-ลิ้นมีปื้นเลือดหรือมีจุดจ้ำเลือด (淤斑点舌)-น.55-55.md</data>
      <data key="d5">1787913359</data>
      <data key="d6" />
    </node>
    <node id="ภาวะเลือดอุดกั้น">
      <data key="d0">ภาวะเลือดอุดกั้น</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะทางการแพทย์แผนจีนที่บ่งบอกว่าในร่างกายมีการอุดตันของเลือด ซึ่งแสดงออกผ่านลักษณะลิ้นมีปื้นเลือดหรือจุดจ้ำเลือด&lt;SEP&gt;ภาวะที่เลือดไหลเวียนติดขัดหรือถูกอุดกั้นในร่างกาย ซึ่งเป็นสาเหตุร่วมของลักษณะลิ้นสีม่วงและน้ำเงินหลายแบบ&lt;SEP&gt;ภาวะที่การแพทย์แผนจีนใช้อธิบายลักษณะหลอดเลือดดำขยายใต้ลิ้น หมายถึงเลือดในร่างกายมีการอุดกั้นไม่ไหลเวียน</data>
      <data key="d3">tongue-100-080-chunk-000&lt;SEP&gt;tongue-100-206-chunk-001&lt;SEP&gt;tongue-100-212-chunk-000</data>
      <data key="d4">080-ลิ้นมีปื้นเลือดหรือมีจุดจ้ำเลือด (淤斑点舌)-น.55-55.md&lt;SEP&gt;206-ตารางเทียบเคียง สี-น.86-88.md&lt;SEP&gt;212-ตารางเทียบเคียง การตรวจหลอดเลือดใต้ลิ้น-น.97-97.md</data>
      <data key="d5">1787914327</data>
      <data key="d6" />
    </node>
    <node id="หลอดเลือดใต้ลิ้นขยาย">
      <data key="d0">หลอดเลือดใต้ลิ้นขยาย</data>
      <data key="d1">concept</data>
      <data key="d2">อาการทางลิ้นในการแพทย์แผนจีน หมายถึงหลอดเลือดดำใต้ลิ้น 2 เส้นที่ค่อนข้างโตและมีความยาวมากกว่า 3 ใน 5 ของระยะทางจากปลายลิ้นถึงโคนลิ้น ร่วมกับมีสีเขียวม่วง เป็นสัญญาณบ่งบอกความผิดปกติของการไหลเวียนชี่และเลือด</data>
      <data key="d3">tongue-100-081-chunk-000</data>
      <data key="d4">081-หลอดเลือดใต้ลิ้นขยาย (瘀血舌下)-น.56-56.md</data>
      <data key="d5">1787913371</data>
      <data key="d6" />
    </node>
    <node id="ชี่ไหลเวียนไม่สะดวก">
      <data key="d0">ชี่ไหลเวียนไม่สะดวก</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ชี่ในร่างกายไหลเวียนไม่สะดวกหรือถูกปิดกั้น เป็นภาวะที่บ่งชี้ได้จากอาการหลอดเลือดใต้ลิ้นขยาย</data>
      <data key="d3">tongue-100-081-chunk-000</data>
      <data key="d4">081-หลอดเลือดใต้ลิ้นขยาย (瘀血舌下)-น.56-56.md</data>
      <data key="d5">1787913371</data>
      <data key="d6" />
    </node>
    <node id="เลือดมีการอุดกั้น">
      <data key="d0">เลือดมีการอุดกั้น</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่เลือดในร่างกายเกิดการอุดกั้นหรือไหลเวียนผิดปกติ (ภาวะเลือดคั่ง) เป็นภาวะที่บ่งชี้ได้จากอาการหลอดเลือดใต้ลิ้นขยาย</data>
      <data key="d3">tongue-100-081-chunk-000</data>
      <data key="d4">081-หลอดเลือดใต้ลิ้นขยาย (瘀血舌下)-น.56-56.md</data>
      <data key="d5">1787913371</data>
      <data key="d6" />
    </node>
    <node id="โรคลิ้นทางการแพทย์แผนจีน">
      <data key="d0">โรคลิ้นทางการแพทย์แผนจีน</data>
      <data key="d1">content</data>
      <data key="d2">องค์ความรู้ทางการแพทย์แผนจีนที่ใช้ลักษณะของลิ้นและอวัยวะที่เกี่ยวข้อง เช่น หลอดเลือดใต้ลิ้น ในการวินิจฉัยความผิดปกติของร่างกาย&lt;SEP&gt;สาขาหนึ่งของการแพทย์แผนจีนที่ศึกษาความสัมพันธ์ระหว่างลักษณะของลิ้นกับสภาวะโรคต่างๆ ในร่างกาย&lt;SEP&gt;หมวดความรู้ทางการแพทย์แผนจีนที่ว่าด้วยลักษณะความผิดปกติของลิ้น ซึ่งใช้เป็นเครื่องมือในการวินิจฉัยโรค รวมถึงลักษณะฝ้าลิ้นบาง&lt;SEP&gt;หมวดหมู่เนื้อหาเกี่ยวกับการวินิจฉัยโรคผ่านลักษณะลิ้นในศาสตร์การแพทย์แผนจีน ซึ่งครอบคลุมลักษณะฝ้าลิ้นหนาเป็นหนึ่งในหัวข้อ</data>
      <data key="d3">tongue-100-081-chunk-000&lt;SEP&gt;tongue-100-086-chunk-000&lt;SEP&gt;tongue-100-090-chunk-000&lt;SEP&gt;tongue-100-091-chunk-000</data>
      <data key="d4">081-หลอดเลือดใต้ลิ้นขยาย (瘀血舌下)-น.56-56.md&lt;SEP&gt;086-ฝ้าลิ้นสีขาว (白苔)-น.57-57.md&lt;SEP&gt;090-ฝ้าลิ้นบาง-น.58-58.md&lt;SEP&gt;091-ฝ้าลิ้นหนา-น.58-58.md</data>
      <data key="d5">1787913432</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นแข็งทื่อ">
      <data key="d0">ลิ้นแข็งทื่อ</data>
      <data key="d1">concept</data>
      <data key="d2">อาการทางลิ้นในการแพทย์แผนจีน (强硬舌) ที่จัดอยู่ในหมวดการเคลื่อนไหวของตัวลิ้น เกิดจากความร้อนทำลายสารน้ำ ความร้อนเข้าสู่เยื่อหุ้มหัวใจ หรือลมตับร่วมกับเสมหะอุดกั้น พบในโรคหลอดเลือดสมองตีบหรือแตก และภาวะเตือนก่อนเกิดโรคหลอดเลือดสมอง</data>
      <data key="d3">tongue-100-082-chunk-000</data>
      <data key="d4">082-ลิ้นแข็งทื่อ (强硬舌)-น.56-56.md</data>
      <data key="d5">1787913372</data>
