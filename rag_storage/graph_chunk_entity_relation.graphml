    </node>
    <node id="ร้อนใน">
      <data key="d0">ร้อนใน</data>
      <data key="d1">concept</data>
      <data key="d2">ร้อนใน (canker sore หรือ aphthous ulcer) เป็นแผลชนิดหนึ่งที่เกิดที่ลิ้นหรือในปาก เริ่มจากตุ่มแล้วแตกเป็นแผลตื้น ๆ ขอบชัดเจนและนูนเล็กน้อย พื้นแผลสีแดง มักเจ็บทำให้เคี้ยวและกินอาหารลำบาก</data>
      <data key="d3">tongue-100-037-chunk-000</data>
      <data key="d4">037-ร้อนใน-น.39-39.md</data>
      <data key="d5">1787913010</data>
      <data key="d6" />
    </node>
