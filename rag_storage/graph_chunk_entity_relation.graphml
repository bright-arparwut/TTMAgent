    <node id="อัมพฤกษ์">
      <data key="d0">อัมพฤกษ์</data>
      <data key="d1">concept</data>
      <data key="d2">อัมพฤกษ์เป็นอาการทางการแพทย์ที่ตามมาหลังจากภาวะโรคหลอดเลือดทางสมองหรือภาวะเตือนก่อนเกิดโรคหลอดเลือดสมอง</data>
      <data key="d3">tongue-100-084-chunk-000</data>
