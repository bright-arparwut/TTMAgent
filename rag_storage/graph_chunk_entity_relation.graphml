    <node id="ผู้หญิง">
      <data key="d0">ผู้หญิง</data>
      <data key="d1">concept</data>
      <data key="d2">ลักษณะที่จัดเข้าเป็นอินตามแผนภาพอิน-หยาง</data>
      <data key="d3">tongue-100-015-chunk-000</data>
      <data key="d4">015-การจำแนกอิน-หยาง-น.20-22.md</data>
      <data key="d5">1787912723</data>
