    <node id="ลิ้นเฉ">
      <data key="d0">ลิ้นเฉ</data>
      <data key="d1">concept</data>
      <data key="d2">ลิ้นเฉ หรือลิ้นเบี้ยว (deviation of tongue) คือความผิดปกติที่ลิ้นไม่นอนนิ่งอยู่ตรงกลางพื้นปาก แต่เฉไปด้านใดด้านหนึ่ง หรือเมื่อแลบลิ้นออกมาแล้วลิ้นเฉไปด้านใดด้านหนึ่ง เป็นอาการที่บ่งชี้ถึงความผิดปกติทางการแพทย์&lt;SEP&gt;ลิ้นเฉ (歪斜舌) เป็นอาการทางลิ้นในโรคลิ้นทางการแพทย์แผนจีน ลักษณะลิ้นเบี้ยวหรือเอียงไปด้านใดด้านหนึ่ง พบในโรคหลอดเลือดทางสมองหรือภาวะเตือนก่อนเกิดโรคหลอดเลือดสมอง&lt;SEP&gt;ลักษณะลิ้นที่เอียงหรือเฉไปด้านใดด้านหนึ่งเมื่อแลบออกมา บ่งชี้ถึงความผิดปกติของวาตะ ลม หรือความผิดปกติทางระบบประสาทและพยาธิสภาพในช่องปาก</data>
      <data key="d3">tongue-100-029-chunk-000&lt;SEP&gt;tongue-100-084-chunk-000&lt;SEP&gt;tongue-100-213-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md&lt;SEP&gt;084-ลิ้นเฉ (歪斜舌)-น.57-57.md&lt;SEP&gt;213-ตารางเทียบเคียง การตรวจการเคลื่อนไหวของตัวลิ้น-น.97-98.md</data>
      <data key="d5">1787914398</data>
      <data key="d6" />
    </node>
    <node id="เนื้องอก">
      <data key="d0">เนื้องอก</data>
      <data key="d1">concept</data>
      <data key="d2">ก้อนเนื้อผิดปกติที่อาจเกิดขึ้นบริเวณพื้นปาก ผลักดันให้ลิ้นเฉหรือเอียงไปยังอีกด้านหนึ่ง</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="ถุงน้ำ">
      <data key="d0">ถุงน้ำ</data>
      <data key="d1">concept</data>
      <data key="d2">ก้อนผิดปกติชนิดหนึ่งที่อาจเกิดขึ้นบริเวณพื้นปาก ผลักดันให้ลิ้นเฉหรือเอียงไปยังอีกด้านหนึ่ง</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="ก้อนที่ลิ้น">
      <data key="d0">ก้อนที่ลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">ก้อนหรือการอักเสบที่เกิดขึ้นทางด้านหนึ่งของลิ้น ทำให้มองดูแล้วรู้สึกว่าลิ้นเฉหรือเอียงไปอีกด้านหนึ่ง</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="อัมพาตประสาทลิ้น">
      <data key="d0">อัมพาตประสาทลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่ประสาทซึ่งไปเลี้ยงลิ้นด้านหนึ่งเป็นอัมพาต ทำให้ลิ้นเฉหรือเอียงไปอีกด้านหนึ่งเมื่อนอนนิ่ง หรือเฉไปทางด้านที่เป็นอัมพาตเมื่อแลบลิ้นออกมา</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="แผลเป็นหรือพังผืด">
      <data key="d0">แผลเป็นหรือพังผืด</data>
      <data key="d1">concept</data>
      <data key="d2">ภาวะที่มีแผลเป็นหรือพังผืดดึงรั้งให้ลิ้นเฉหรือเอียงไปทางด้านใดด้านหนึ่ง</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="ความผิดปกติของริมฝีปาก ฟัน หรือเหงือก">
      <data key="d0">ความผิดปกติของริมฝีปาก ฟัน หรือเหงือก</data>
      <data key="d1">concept</data>
      <data key="d2">ความผิดปกติบริเวณริมฝีปาก ฟัน หรือเหงือก เช่น มีแผลเป็นดึงรั้งให้ปากเบี้ยว หรือฟันหักหลุด หรือเหงือกผิดปกติ ทำให้ลิ้นที่แลบออกมาเฉหรือเอียงไปตามลักษณะความผิดปกตินั้น</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="กล้ามเนื้อลิ้น">
      <data key="d0">กล้ามเนื้อลิ้น</data>
      <data key="d1">concept</data>
      <data key="d2">กล้ามเนื้อของลิ้นที่เรียงตัวกันในลักษณะเฉ ๆ เอียง ๆ เมื่อใช้กล้ามเนื้อลิ้นด้านเดียวแลบลิ้น ลิ้นจะเฉไปอีกด้านหนึ่ง และเมื่อกล้ามเนื้อลิ้นด้านหนึ่งเป็นอัมพาต กล้ามเนื้อด้านดีจะดึงลิ้นให้เอียงไปทางด้านดี</data>
      <data key="d3">tongue-100-029-chunk-000</data>
      <data key="d4">029-ลิ้นเฉ-น.35-35.md</data>
      <data key="d5">1787912939</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นขรุขระมาก">
      <data key="d0">ลิ้นขรุขระมาก</data>
      <data key="d1">concept</data>
      <data key="d2">ลิ้นขรุขระมาก (strawberry tongue) หมายถึง ลิ้นที่มีพื้นผิวขรุขระมากกว่าปกติ ซึ่งเกิดจากตุ่มหรือต่อมรับรสโตขึ้นกว่าปกติ มักพบในกรณีที่ลิ้นอักเสบจากสาเหตุต่าง ๆ</data>
      <data key="d3">tongue-100-031-chunk-000</data>
      <data key="d4">031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md</data>
      <data key="d5">1787912944</data>
      <data key="d6" />
    </node>
    <node id="Strawberry Tongue">
      <data key="d0">Strawberry Tongue</data>
      <data key="d1">concept</data>
      <data key="d2">ชื่อภาษาอังกฤษของอาการลิ้นขรุขระมาก ใช้เรียกลิ้นที่มีพื้นผิวขรุขระคล้ายผลสตรอว์เบอร์รี</data>
      <data key="d3">tongue-100-031-chunk-000</data>
      <data key="d4">031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md</data>
      <data key="d5">1787912944</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นอักเสบ">
      <data key="d0">ลิ้นอักเสบ</data>
      <data key="d1">concept</data>
      <data key="d2">ลิ้นอักเสบ (glossitis) เป็นภาวะที่มีสาเหตุต่าง ๆ ซึ่งมักทำให้เกิดอาการลิ้นขรุขระมาก&lt;SEP&gt;ภาวะลิ้นอักเสบที่เป็นสาเหตุส่วนใหญ่ของลิ้นแผนที่ ทำให้บางส่วนของลิ้นบวม หนา และแดง แต่บางส่วนของลิ้นฝ่อตัวทำให้เรียบเลี่ยนและอาจเป็นฝ้า&lt;SEP&gt;ลิ้นอักเสบ (glossitis) หมายถึงภาวะที่ลิ้นบวมแดง ร้อนและเจ็บ อาจเกิดร่วมกับภาวะลิ้นเล็ก ลิ้นบวม ลิ้นแห้ง ลิ้นเลี่ยน ลิ้นขรุขระ และมักเกิดร่วมกับการอักเสบในส่วนอื่น ๆ ของปาก&lt;SEP&gt;ภาวะ glossitis ที่เป็นผลจากโรคซิฟิลิสระยะหลัง ทำให้ลิ้นเลี่ยนและเกิดรอยด้านขาว</data>
      <data key="d3">tongue-100-031-chunk-000&lt;SEP&gt;tongue-100-033-chunk-000&lt;SEP&gt;tongue-100-035-chunk-000&lt;SEP&gt;tongue-100-038-chunk-000</data>
      <data key="d4">031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md&lt;SEP&gt;033-ลิ้นแผนที่ (geographic tongue)-น.37-37.md&lt;SEP&gt;035-ลิ้นอักเสบ (glossitis)-น.38-38.md&lt;SEP&gt;038-แผลซิฟิลิส-น.40-40.md</data>
      <data key="d5">1787913023</data>
      <data key="d6" />
    </node>
    <node id="Scarlet Fever">
      <data key="d0">Scarlet Fever</data>
      <data key="d1">concept</data>
      <data key="d2">ชื่อภาษาอังกฤษของโรคไข้อีดำอีแดง ซึ่งเป็นสาเหตุหนึ่งของลิ้นขรุขระมาก</data>
      <data key="d3">tongue-100-031-chunk-000</data>
      <data key="d4">031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md</data>
      <data key="d5">1787912944</data>
      <data key="d6" />
    </node>
    <node id="Typhoid Fever">
      <data key="d0">Typhoid Fever</data>
      <data key="d1">concept</data>
      <data key="d2">ชื่อภาษาอังกฤษของโรคไข้รากสาดน้อย ซึ่งเป็นสาเหตุหนึ่งของลิ้นขรุขระมาก</data>
      <data key="d3">tongue-100-031-chunk-000</data>
      <data key="d4">031-ลิ้นขรุขระมาก (strawberry tongue)-น.36-36.md</data>
      <data key="d5">1787912944</data>
      <data key="d6" />
    </node>
    <node id="ลิ้นเลี่ยนหรือเรียบ">
      <data key="d0">ลิ้นเลี่ยนหรือเรียบ</data>
      <data key="d1">concept</data>
      <data key="d2">อาการทางลิ้นที่มีผิวเรียบหรือเลี่ยนกว่าปกติ เนื่องจากตุ่มและต่อมลิ้มรสฝ่อตัว มักพบร่วมกับโรคทางการแพทย์แผนปัจจุบันหลายชนิด</data>
      <data key="d3">tongue-100-030-chunk-000</data>
      <data key="d4">030-ลิ้นเลี่ยนหรือเรียบ-น.36-36.md</data>
      <data key="d5">1787912948</data>
      <data key="d6" />
