    <node id="ยากลุ่มหมอนรองกระดูกทับเส้น">
      <data key="d0">ยากลุ่มหมอนรองกระดูกทับเส้น</data>
      <data key="d1">artifact</data>
      <data key="d2">ยากลุ่มที่ให้แก่ผู้ป่วย ประกอบด้วยปวดเส้นพิเศษ</data>
      <data key="d3">tongue-100-201-chunk-000</data>
      <data key="d4">201-กรณีศึกษา-น.79-80.md</data>
      <data key="d5">1787914017</data>
