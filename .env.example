# LINE Messaging API (from the LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Advisor Model slot -- config-selected, no fixed default.
# provider: "openai" (any OpenAI-compatible endpoint, incl. Typhoon), "anthropic", or "google"
# See docs/adr/0001-two-model-pipeline.md.
ADVISOR_PROVIDER=openai
ADVISOR_MODEL=typhoon-v2.1-12b-instruct
ADVISOR_API_KEY=
ADVISOR_BASE_URL=https://api.opentyphoon.ai/v1

# Vision Describer slot -- independently config-selected.
DESCRIBER_PROVIDER=anthropic
DESCRIBER_MODEL=claude-opus-4-8
DESCRIBER_API_KEY=
DESCRIBER_BASE_URL=

# Roboflow hosted tongue detector
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE_THRESHOLD=0.5
ROBOFLOW_CROP_PADDING_RATIO=0.12

# MongoDB (Health Records + working buffer only -- not used for RAG)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ttm_advisor

# Chroma (embedded, persisted to a local folder) + BGE-M3 (local embeddings)
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_TOP_K=5

# Consultation lifecycle
CONSULTATION_GAP_HOURS=6.0
HEALTH_RECORD_INJECT_COUNT=3
