# NOTE: Settings() requires a .env to construct -- copy this file to .env
# (even with placeholders left blank) before running anything, including
# tests and one-off scripts, in a fresh worktree.

# LINE Messaging API (from the LINE Developers Console)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Advisor Model slot -- config-selected, no fixed default.
# provider: "openai" (any OpenAI-compatible endpoint, incl. Typhoon), "anthropic", or "google"
# See docs/adr/0001-two-model-pipeline.md.
ADVISOR_PROVIDER=openai
ADVISOR_MODEL=typhoon-v2.1-12b-instruct
ADVISOR_API_KEY=
ADVISOR_BASE_URL=https://api.opentyphoon.ai/v1

# Vision Describer slot -- independently config-selected.
DESCRIBER_PROVIDER=anthropic
DESCRIBER_MODEL=claude-opus-4-8
DESCRIBER_API_KEY=
DESCRIBER_BASE_URL=

# KEYWORD slot -- LightRAG's retrieval keyword-extraction call, config-selected
# like the other slots. Without a key here, rag_query_mode=mix silently
# degrades to naive on every message (ADR 0010).
KEYWORD_PROVIDER=google
KEYWORD_MODEL=gemini-2.5-flash
KEYWORD_API_KEY=
KEYWORD_BASE_URL=

# Roboflow serverless workflow (tongue detect + server-side crop)
# See docs/adr/0004-serverless-workflow-crop.md for the console-side invariants.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE_NAME=
ROBOFLOW_WORKFLOW_ID=tongue-detect-crop
ROBOFLOW_CONFIDENCE_THRESHOLD=0.5

# Public HTTPS origin of this app -- the named tunnel hostname (ADR 0007).
# Empty disables the tongue-photo image echo. See docs/demo-runbook.md.
PUBLIC_BASE_URL=

# MongoDB (Health Records + working buffer only -- not used for RAG)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=ttm_advisor

# BGE-M3 (local embeddings)
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# Demo/live runs: load BGE-M3 at boot instead of on the first message
# (docs/demo-runbook.md). Leave 0 for dev -- every --reload restart would
# pay the ~15-23 s model load.
EMBEDDING_PREWARM=0

# Consultation lifecycle
CONSULTATION_GAP_HOURS=6.0
HEALTH_RECORD_INJECT_COUNT=3
